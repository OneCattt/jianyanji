NODE_ENV=development
APP_PRODUCTION=false
HOST=127.0.0.1
PORT=3100
# Java 8 / MySQL 8；先创建空库，表由 Flyway 自动迁移。
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/jianyanji?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
MYSQL_USER=jianyanji
MYSQL_PASSWORD=请替换数据库密码
# 可选：本地使用的 JDK 8 与 Maven settings 绝对路径。
# JAVA8_HOME=/path/to/jdk8
# MAVEN_SETTINGS=/path/to/settings.xml
# 路径相对于 backend 工作目录；生产建议指定绝对路径。
WEB_DIST=../dist
ASSETS_DIR=../miniprogram/assets
# 仅本地体验开启；生产必须关闭。
DEV_AUTH=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 后台公开图片直传 OSS；仅服务端读取，不能加 VITE_ 前缀。
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：使用临时凭证时同步提供安全令牌，需在过期前更新服务端配置。
OSS_SECURITY_TOKEN=
# 可选：已配置的 HTTPS 图片域名，留空则使用 Bucket 公网域名。
OSS_PUBLIC_BASE_URL=
# 首次创建正式管理员时填写，随后执行 npm run bootstrap:admin。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 首期所有资金收付均在线下办理，无需配置微信支付商户、证书或通知地址。

# 品牌已部署的 HTTPS MP4 精确主机白名单（逗号分隔）；留空禁止视频录入发布。
CONTENT_VIDEO_HOSTS=
