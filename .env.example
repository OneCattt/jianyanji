NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DB_PATH=./data/jianyanji.sqlite
# 仅本地体验开启；生产必须关闭。
DEV_AUTH=true
# 正式微信登录由服务端配置，禁止写入小程序。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 首次创建正式管理员时填写，随后执行 npm run bootstrap:admin。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 真实微信支付 V3，均为服务端参数；PEM 密钥文件不得提交仓库。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
# 使用外网可访问的 HTTPS 地址，路径为 /api/payments/wechat/notify。
WECHAT_PAY_NOTIFY_URL=
