.tab-bar {
  position: fixed;
  z-index: 100;
  bottom: 0;
  right: 0;
  left: 0;
  display: flex;
  padding: 15.957rpx 35.904rpx 23.936rpx;
  padding-bottom: max(23.936rpx, env(safe-area-inset-bottom));

  background: #fff;
  border-top: 0.5px solid #efece6;

  box-sizing: border-box;
  border-color: #eee9e4;
}
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7.979rpx;
  height: 113.697rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #a39891;
  font-family: "PingFang SC", sans-serif;
  line-height: 1.5;
}
.tab-item::after {
  border: 0;
}
.tab-item.tab-selected {
  color: #7a1c1c;
}
.tab-indicator {
  position: absolute;
  top: -15.957rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 53.856rpx;
  height: 3.989rpx;
  background: #7a1c1c;
  border-radius: 2px;
}
.tab-icon {
  display: block;
  width: 41.888rpx;
  height: 41.888rpx;
}
.tab-label {
  font-size: 11px;
  line-height: 29.92rpx;
}

/* 首页、商城和个人中心沿用原来的底部导航。 */
.tab-bar-original {
  background: #faf8f5;
  border-color: currentColor;
  border-top-color: #efece6;
}
.tab-bar-original .tab-item.tab-selected {
  color: #8d1724;
}
.tab-bar-original .tab-indicator {
  background: #8d1724;
  border-radius: 0;
}
.tab-bar-original .tab-label {
  font-size: 19.947rpx;
}
