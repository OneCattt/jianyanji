@import "figma.wxss";
.qx-count-badge {
  position: absolute;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 24rpx;
  background: #7a1c1c;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

page {
  background: #f5f4f2;
  color: #2c221e;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
view,
input,
button {
  box-sizing: border-box;
}
.page {
  padding: 16px 8px calc(24px + env(safe-area-inset-bottom));
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #12665c;
}
.title {
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 22px;
  letter-spacing: 0;
  margin: 22rpx 0;
  font-weight: 600;
}
.sub {
  font-size: 24rpx;
  color: #76867f;
  line-height: 1.9;
}
.primary {
  margin: 38rpx 0 0;
  background: #7a1c1c;
  color: #fff;
  border-radius: 24px;
  font-size: 14px;
  line-height: 44px;
  min-height: 44px;
}
.primary::after,
button::after {
  border: 0;
}
.secondary {
  background: #f5e9e9;
  color: #7a1c1c;
  border-radius: 24px;
  font-size: 26rpx;
  line-height: 44px;
  margin-top: 24rpx;
  min-height: 44px;
}
.card {
  background: #fff;
  border: 0;
  border-radius: 12px;
  padding: 18px 16px;
  margin-top: 10px;
}
.identity-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 94rpx;
  height: 94rpx;
  background: #fbfcfa;
  border-radius: 50%;
  text-align: center;
  line-height: 94rpx;
  font-size: 40rpx;
  color: #12665c;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
}
.tag {
  display: inline-block;
  border: 1rpx solid #abc7b7;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #356b50;
  padding: 4rpx 12rpx;
  margin-top: 12rpx;
}
.card .sub {
  margin-top: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 48rpx 0 20rpx;
}
.label {
  font-size: 24rpx;
  color: #76867f;
  margin: 28rpx 0 12rpx;
}
input {
  height: 44px;
  border: 1rpx solid #eee9e4;
  background: #f5f4f2;
  border-radius: 8px;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.help {
  font-size: 22rpx;
  color: #76867f;
  line-height: 1.9;
  margin-top: 24rpx;
}
.logout {
  font-size: 24rpx;
  color: #76867f;
  text-align: center;
  background: none;
  margin-top: 35rpx;
}
.dev {
  margin-top: 48rpx;
  border-top: 1rpx dashed #cbd9ce;
  padding-top: 24rpx;
  font-size: 22rpx;
  color: #76867f;
}
.error {
  background: #f7eceb;
  color: #7a1c1c;
  padding: 12px 16px;
  font-size: 24rpx;
  margin-top: 24rpx;
  border-radius: 8px;
}
.brand-hero {
  position: relative;
  background: #e3eee7;
  padding: 65rpx 48rpx 70rpx;
  overflow: hidden;
  min-height: 550rpx;
}
.brand-hero .title {
  font-size: 65rpx;
  line-height: 1.6;
  margin: 28rpx 0;
}
.leaf {
  position: absolute;
  right: -15rpx;
  bottom: 30rpx;
  width: 190rpx;
  height: 360rpx;
  border-radius: 95% 0 95% 0;
  background: #aac3a544;
  transform: rotate(-18deg);
  border: 1rpx solid #9cb69955;
}
.welcome {
  padding: 45rpx 48rpx;
}
.welcome .section-title {
  margin-top: 24rpx;
}
.empty {
  text-align: center;
  padding-top: 120rpx;
}

/* 列表状态使用稳定占位，数据刷新时保留现有内容。 */
.list-footer {
  min-height: 72rpx;
  padding: 20rpx;
  text-align: center;
  color: #796f68;
  font-size: 24rpx;
  box-sizing: border-box;
}
.list-footer button {
  font-size: 24rpx;
  color: #7a1c1c;
  background: transparent;
  min-height: 44px;
}
.list-footer button::after {
  border: 0;
}
