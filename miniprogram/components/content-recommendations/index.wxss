.recommendations {
  margin: 10px 8px 0;
  color: #2c221e;
  padding: 18px 16px;
  border-top: 0;
  border-radius: 12px;
  background: #fff;
}
button {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.6;
  text-align: left;
  white-space: normal;
}
.heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0;
}
.heading button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
  min-height: 44px;
  font-size: 24rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-weight: 400;
  letter-spacing: 0;
  color: #796f68;
}
.recommendation {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  text-align: left;
  white-space: normal;
  padding: 16px 0;
  font-size: 28rpx;
  line-height: 1.6;
}
.recommendation + .recommendation {
  border-top: 1rpx solid #eee9e4;
}
.recommendation image {
  width: 80px;
  height: 96px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #f0eae2;
}
.recommendation-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.recommendation-type {
  color: #a68b7c;
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
}
.recommendation-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.6;
}
.recommendation-summary {
  margin-top: 12rpx;
  color: #796f68;
  font-size: 24rpx;
  line-height: 1.8;
}
.recommendation-title,
.recommendation-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.empty {
  color: #796f68;
  padding: 24rpx 0 32rpx;
  font-size: 26rpx;
}
.empty button {
  min-height: 44px;
  color: #7a1c1c;
}
.entry-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}
.entry-pressed {
  opacity: 0.65;
}
button::after {
  border: 0;
}
