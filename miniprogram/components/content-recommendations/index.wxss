.recommendations {
  margin: 40rpx 32rpx 0;
  color: #46332a;
  padding: 16rpx 24rpx 0;
  background: #fffdfa;
}
button {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.6;
  text-align: left;
  white-space: normal;
}
.heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.heading button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
  min-height: 44px;
  font-size: 24rpx;
  font-weight: 400;
  color: #786a62;
}
.recommendation {
  display: flex;
  gap: 24rpx;
  width: 100%;
  text-align: left;
  white-space: normal;
  padding: 24rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}
.recommendation image {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}
.recommendation text {
  font-size: 24rpx;
  color: #8e8178;
}
.recommendation-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.empty {
  color: #8e8178;
  padding: 24rpx 0 32rpx;
  font-size: 26rpx;
}
.empty button {
  min-height: 44px;
  color: #8d1724;
}
.entry-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}
.entry-pressed {
  opacity: 0.65;
}
button::after {
  border: 0;
}
