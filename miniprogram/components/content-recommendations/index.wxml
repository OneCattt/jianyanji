<view class="recommendations"><view class="heading"><text>品牌种草</text><button bindtap="all">查看全部 ›</button></view><button wx:for="{{items}}" wx:key="id" class="recommendation" data-id="{{item.id}}" bindtap="open"><image src="{{item.cover}}" mode="aspectFill" lazy-load/><view><view>{{item.title}}</view><text>{{item.type==='video'?'短视频':'品牌图文'}} · {{item.summary}}</text></view></button><view wx:if="{{!items.length && !error}}" class="empty">品牌内容尚未发布</view><view wx:if="{{error}}" class="empty">{{error}}<button bindtap="load">重新读取</button></view><button class="course-entry" bindtap="courses">课程与成长权益 · 查看介绍和联系报名 ›</button></view>
