.tab-navigation {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 100;
  box-sizing: border-box;
  background: #f5f4f2;
  color: #2c221e;
}
.tab-navigation-title {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 100px;
  box-sizing: border-box;
  font-size: 17px;
  font-weight: 500;
  white-space: nowrap;
}
.tab-navigation-brand {
  background: #f5f4f2;
}
.tab-navigation-brand .tab-navigation-title {
  justify-content: flex-start;
  padding-right: 110px;
  padding-left: 16px;
}
.tab-navigation-brand .tab-navigation-name {
  color: #7a1c1c;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 26px;
  letter-spacing: 0;
}

/* 首页与商城继续使用原有页首。 */
.tab-navigation-original {
  background: #f8f5ee;
  color: #251d1a;
}
.tab-navigation-original.tab-navigation-brand {
  background: #faf8f5;
}
.tab-navigation-original .tab-navigation-title {
  padding-left: 100px;
}
.tab-navigation-original.tab-navigation-brand .tab-navigation-title {
  padding-left: 28px;
}
.tab-navigation-original.tab-navigation-brand .tab-navigation-name {
  color: #6e2c2c;
  font-family: STSong, "Songti SC", serif;
  font-size: 20px;
  font-weight: 500;
  letter-spacing: 2px;
}

/* 首页导航叠在主图上，保留原占位，使海报文案与下方内容不位移。 */
.tab-navigation.tab-navigation-overlay {
  position: absolute;
  background: transparent;
  color: #fff;
}
.tab-navigation-overlay.tab-navigation-brand .tab-navigation-name {
  color: #fff;
}
