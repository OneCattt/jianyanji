.login-mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 25, 22, 0.42);
}
.login-panel {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 32px 24px calc(20px + env(safe-area-inset-bottom));
  border-radius: 24px 24px 0 0;
  background: #faf8f5;
  color: #2c221e;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.login-scroll {
  max-height: 76vh;
}
.login-panel button {
  box-sizing: border-box;
  margin: 0;
  border: 0;
  border-radius: 24px;
  font-size: 14px;
  line-height: 1.6;
  min-height: 44px;
  padding: 12px 16px;
}
.login-panel button::after {
  border: 0;
}
.login-panel button[disabled] {
  opacity: 0.5;
}
.login-panel .login-close {
  position: absolute;
  top: 10px;
  right: 12px;
  z-index: 1;
  width: 44px;
  height: 44px;
  padding: 0;
  background: transparent;
  color: #796f68;
  font-size: 28px;
}
.login-brand {
  color: #7a1c1c;
  font-size: 13px;
  letter-spacing: 2px;
}
.login-title {
  margin-top: 12px;
  padding-right: 20px;
  font-size: 24px;
  font-weight: 600;
  line-height: 1.5;
}
.login-note {
  margin-top: 12px;
  color: #796f68;
  font-size: 13px;
  line-height: 1.8;
}
.login-contact {
  margin-top: 6px;
  color: #796f68;
  font-size: 12px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.login-agreement {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
  font-size: 13px;
  line-height: 1.8;
}
.login-agreement checkbox {
  flex-shrink: 0;
}
.login-links {
  display: flex;
  flex-wrap: wrap;
}
.login-panel .login-links button {
  padding: 8px 10px;
  background: transparent;
  color: #7a1c1c;
  font-size: 12px;
}
.login-panel .login-primary {
  width: 100%;
  margin-top: 22px;
  color: #fff;
  background: #7a1c1c;
}
.login-panel .login-secondary {
  width: 100%;
  margin-top: 8px;
  color: #796f68;
  background: transparent;
}
.login-label {
  margin: 22px 0 10px;
  font-size: 13px;
  font-weight: 500;
}
.login-panel input {
  box-sizing: border-box;
  width: 100%;
  height: 48px;
  padding: 0 12px;
  border: 1px solid #eae4df;
  border-radius: 8px;
  background: #fff;
  font-size: 14px;
}
.login-phone {
  min-height: 32px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 14px;
}
.login-phone text {
  color: #796f68;
  font-size: 12px;
}
.login-error {
  margin-top: 12px;
  padding: 12px;
  border-radius: 8px;
  color: #7a1c1c;
  background: #f5e9e9;
  font-size: 13px;
  line-height: 1.7;
}
