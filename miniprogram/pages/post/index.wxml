<view class="qx qx-flow"><view class="qx-flow-content"><view wx:if="{{loading}}" class="qx-empty">正在读取内容…</view><view wx:if="{{error}}" class="error">{{error}}<button class="qx-text" bindtap="load">重试</button></view><block wx:if="{{post}}"><view class="qx-sheet"><view class="qx-h2">{{post.title}}</view><view class="qx-muted">{{post.summary}}</view><video wx:if="{{post.type==='video' && !videoError}}" class="post-video" src="{{post.video_url}}" poster="{{post.cover}}" controls show-center-play-btn show-fullscreen-btn enable-play-gesture binderror="videoError" /><view wx:if="{{videoError}}" class="qx-notice">{{videoError}}<button class="qx-text" bindtap="retryVideo">重试播放</button></view><view class="post-body">{{post.body}}</view><image wx:for="{{post.imageUrls}}" wx:key="*this" class="post-image" src="{{item}}" mode="widthFix" lazy-load data-url="{{item}}" bindtap="preview" /><button class="qx-primary" open-type="share">分享这篇内容</button></view><view wx:if="{{post.products.length}}" class="qx-sheet"><view class="qx-label">内容相关商品</view><button wx:for="{{post.products}}" wx:key="id" class="post-product" data-id="{{item.id}}" bindtap="product"><image src="{{item.image}}" mode="aspectFill"/><text>{{item.name}} ›</text></button></view></block></view></view>
