<view class="qx qx-flow"><view class="qx-flow-content"><view wx:if="{{!editing}}"><view class="qx-sheet" wx:for="{{items}}" wx:key="id"><view data-id="{{item.id}}" bindtap="choose"><view>{{item.recipient}} {{item.phone}} <text wx:if="{{item.is_default}}" class="qx-badge">默认</text></view><view class="qx-about">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</view></view><view class="qx-section-row"><button class="qx-text" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="qx-text" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">移除</button></view></view><button class="qx-primary qx-wide" bindtap="add">新增收货地址</button></view><view wx:else class="qx-sheet"><view class="qx-label">收货人</view><input value="{{form.recipient}}" data-key="recipient" bindinput="input" maxlength="40"/><view class="qx-label">联系电话</view><input value="{{form.phone}}" data-key="phone" bindinput="input" type="number" maxlength="11"/><view class="qx-label">所在地区</view><picker mode="region" value="{{[form.province,form.city,form.district]}}" bindchange="region"><view class="qx-about">{{form.province ? form.province+' '+form.city+' '+form.district : '请选择省 / 市 / 区'}}</view></picker><view class="qx-label">详细地址</view><input value="{{form.detail}}" data-key="detail" bindinput="input" maxlength="200"/><view class="qx-info-row"><text>设为默认</text><switch checked="{{form.isDefault}}" color="#8d1724" bindchange="toggle"/></view><button class="qx-primary qx-wide" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存地址</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view></view>
