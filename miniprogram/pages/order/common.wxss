page {
  background: #f5f4f2;
}
.jy-orders {
  background: #f5f4f2;
  min-height: 100vh;
  color: #2c221e;
  font-size: 14px;
}
.jy-list {
  padding: 8px 8px 24px;
}
.jy-card {
  background: #ffffff;
  padding: 0 16px 16px;
  margin-bottom: 10px;
  border-radius: 12px;
}
.jy-order-top {
  height: auto;
  border-bottom: 1.995rpx solid #eee9e4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  color: #796f68;
  font-size: 12px;
  min-height: 44px;
  padding: 8px 0;
}
.jy-order-top > text:first-child {
  overflow-wrap: anywhere;
}
.jy-status {
  color: #7a1c1c;
  font-size: 12px;
  flex-shrink: 0;
}
.jy-product {
  display: flex;
  gap: 19.947rpx;
  padding: 25.931rpx 0 9.973rpx;
  align-items: flex-start;
}
.jy-product > image {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #f5f4f2;
}
.jy-product-copy {
  flex: 1;
  min-width: 0;
  font:
    500 14px/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  padding-top: 7.979rpx;
}
.jy-product-copy text {
  display: block;
  font:
    12px/1.6 -apple-system,
    "PingFang SC",
    sans-serif;
  color: #796f68;
  margin-top: 6px;
}
.jy-line-price {
  text-align: right;
  font-size: 13px;
  padding-top: 7.979rpx;
  line-height: 1.6;
  max-width: 180rpx;
  overflow-wrap: anywhere;
}
.jy-line-price > view {
  font-size: 12px;
  color: #796f68;
  margin-top: 11.968rpx;
}
.jy-order-hint {
  background: #f5e9e9;
  display: flex;
  gap: 15.957rpx;
  align-items: center;
  padding: 19.947rpx;
  margin-top: 19.947rpx;
  color: #796f68;
  font-size: 12px;
  line-height: 1.6;
  border-radius: 8px;
}
.jy-order-hint image {
  width: 33.91rpx;
  height: 33.91rpx;
  flex-shrink: 0;
}
.jy-order-bottom {
  border-top: 1.995rpx solid #eee9e4;
  margin-top: 25.931rpx;
  padding-top: 23.936rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15rpx;
  font-size: 12px;
  color: #796f68;
  flex-wrap: wrap;
}
.jy-total {
  color: #2c221e;
  font-weight: 600;
}
.jy-order-bottom button {
  border: 1.995rpx solid #7a1c1c;
  color: #7a1c1c;
  font-size: 13px;
  padding: 10px 18px;
  flex-shrink: 0;
  min-height: 44px;
  border-radius: 24px;
}
.jy-empty {
  padding: 79.787rpx 25.931rpx;
  text-align: center;
  color: #796f68;
  line-height: 1.8;
}
.jy-error {
  margin: 19.947rpx 27.926rpx;
  padding: 23.936rpx;
  background: #f4e2de;
  color: #7a1c1c;
  line-height: 1.8;
  font-size: 21.941rpx;
  overflow-wrap: anywhere;
}
.jy-error button {
  display: inline;
  color: #7a1c1c;
  text-decoration: underline;
  margin-left: 15rpx;
}
.jy-banner {
  min-height: 181.516rpx;
  display: flex;
  gap: 33.91rpx;
  align-items: center;
  padding: 20px 16px;
  background: #fff;
  color: #7a1c1c;
  margin: 8px 8px 0;
  border-radius: 12px;
}
.jy-banner > image {
  width: 47.872rpx;
  height: 47.872rpx;
  flex-shrink: 0;
}
.jy-banner > view > view {
  font:
    35.904rpx/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  letter-spacing: 0;
  font-size: 20px;
  font-weight: 600;
}
.jy-banner text {
  display: block;
  font-size: 12px;
  color: #796f68;
  margin-top: 11.968rpx;
  line-height: 1.8;
}
.jy-logistics-link,
.jy-address {
  display: flex;
  gap: 23.936rpx;
  align-items: center;
  padding: 18px 16px;
}
.jy-logistics-link > image,
.jy-address > image {
  width: 35.904rpx;
  height: 35.904rpx;
  flex-shrink: 0;
}
.jy-logistics-link > view,
.jy-address > view {
  flex: 1;
  min-width: 0;
  font-weight: 600;
}
.jy-logistics-link text,
.jy-address text {
  font-size: 12px;
  display: block;
  color: #796f68;
  line-height: 1.8;
  margin-top: 11.968rpx;
  font-weight: 400;
}
.jy-logistics-link .jy-arrow {
  width: 27.926rpx;
  height: 27.926rpx;
}
.jy-store {
  display: flex;
  gap: 19.947rpx;
  align-items: center;
  border-bottom: 1.995rpx solid #eee9e4;
  padding: 29.92rpx 0;
  color: #2c221e;
  font-size: 14px;
  font-weight: 600;
}
.jy-store image {
  width: 33.91rpx;
  height: 33.91rpx;
}
.jy-info {
  padding: 10px 16px;
}
.jy-info > view {
  display: flex;
  justify-content: space-between;
  gap: 19.947rpx;
  padding: 15.957rpx 0;
  line-height: 1.8;
  font-size: 13px;
}
.jy-info > view > text:first-child {
  color: #796f68;
  flex-shrink: 0;
}
.jy-info > view > text:last-child,
.jy-info button {
  text-align: right;
  max-width: 75%;
  overflow-wrap: anywhere;
  color: #5f514a;
}
.jy-contact {
  display: flex;
  gap: 15.957rpx;
  align-items: center;
  padding: 16px;
  background: #fff;
  color: #7d5a46;
  font-size: 12px;
  border-radius: 12px;
}
.jy-contact image {
  width: 35.904rpx;
  height: 35.904rpx;
  flex-shrink: 0;
}
.jy-contact text {
  flex: 1;
  line-height: 1.7;
}
.jy-contact button {
  border: 0;
  padding: 10px 14px;
  font-size: 12px;
  color: #7a1c1c;
  border-radius: 24px;
  min-height: 44px;
  background: #f5e9e9;
  flex-shrink: 0;
}
.jy-detail {
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}
.jy-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 8px;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1.995rpx solid #eee9e4;
  box-shadow: none;
}
.jy-actions button {
  flex: 1;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  min-width: 0;
  border-radius: 24px;
  padding: 10px 8px;
}
.qx .jy-outline {
  background: #f5e9e9;
  color: #7a1c1c;
  padding: 19.947rpx;
  border-radius: 24px;
}
.qx .jy-solid {
  background: #7a1c1c;
  color: #fff;
  padding: 19.947rpx;
  font-size: 14px;
  min-height: 44px;
  border-radius: 24px;
}
.jy-orders button[disabled] {
  opacity: 0.45;
}
.jy-timeline {
  padding: 39.894rpx 35.904rpx;
}
.jy-step {
  position: relative;
  margin-left: 7.979rpx;
  border-left: 1.995rpx solid #dacbc1;
  padding: 0 0 59.84rpx 43.883rpx;
  color: #70645d;
  font-size: 14px;
}
.jy-step:before {
  content: "";
  position: absolute;
  left: -9.973rpx;
  top: 3.989rpx;
  width: 13.963rpx;
  height: 13.963rpx;
  border: 3.989rpx solid #cabbb0;
  border-radius: 50%;
  background: #ffffff;
}
.jy-step.active {
  color: #7a1c1c;
}
.jy-step.active:before {
  background: #7a1c1c;
  border-color: #f0d6d9;
}
.jy-step text {
  display: block;
  font-size: 12px;
  color: #a89c95;
  margin-top: 13.963rpx;
}
.jy-track-note {
  color: #796f68;
  font-size: 12px;
  line-height: 1.8;
  margin-bottom: 23.936rpx;
}
.jy-process {
  background: #fff;
  padding: 18px 16px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
}
.jy-process-icons {
  display: flex;
  justify-content: space-around;
  margin-top: 39.894rpx;
}
.jy-process-icons > view {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 17.952rpx;
  font-size: 11px;
  font-weight: 400;
  min-width: 0;
  text-align: center;
}
.jy-process-icons image {
  width: 53.856rpx;
  height: 53.856rpx;
}
