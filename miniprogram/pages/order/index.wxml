<view class="qx jy-orders jy-detail">
  <view wx:if="{{error}}" class="jy-error"
    >{{error}}<button bindtap="load">重新查询</button></view
  >
  <block wx:if="{{order}}">
    <view class="jy-banner"
      ><image src="assets/detail-imgIcon1.png" /><view
        ><view>{{order.stateText}}</view><text>{{order.hint}}</text></view
      ></view
    >
    <view wx:if="{{justPaid}}" class="jy-card jy-paid-result">
      <view class="jy-store"
        >{{order.kind === 'package' ? (identityActivated ? '支付成功，身份已开通' : '付款成功，身份状态待核实') : '积分支付成功'}}</view
      >
      <view class="jy-paid-copy"
        >{{order.kind === 'package' ? (identityActivated ? '身份已开通，商品按本次配送与寄存安排交付。' : '付款结果已保留，请勿重复支付，身份状态可稍后刷新核实。') : '本次积分已扣减，品牌仓将按本次配送与寄存安排履约。'}}</view
      >
      <view class="jy-paid-actions"
        ><button
          wx:if="{{order.storageRemainingQty>0}}"
          class="jy-solid"
          bindtap="storage"
        >
          查看我的寄存
        </button>
        <button
          wx:elif="{{order.shipments.length}}"
          class="jy-solid"
          bindtap="logistics"
        >
          查看配送
        </button>
        <button class="jy-outline" bindtap="myOrders">我的订单</button>
        <button class="jy-outline" bindtap="toMall">继续逛商城</button>
      </view>
    </view>
    <view class="jy-list">
      <view class="jy-card jy-logistics-link" bindtap="logistics"
        ><image src="assets/detail-imgIcon2.png" /><view
          ><view
            >{{order.shipments.length?'查看包裹物流':'品牌仓履约进度'}}</view
          ><text
            >{{order.shipments.length?'查看物流公司和运单号':order.paid?'查看品牌仓配送安排与包裹进度':'积分扣减成功后由品牌仓安排发货'}}</text
          ></view
        ><image class="jy-arrow" src="assets/detail-imgIcon3.png"
      /></view>
      <view class="jy-card jy-address"
        ><image src="assets/detail-imgIcon4.png" /><view
          ><view
            >{{order.snapshot.address.recipient}}
            {{order.snapshot.address.phone}}</view
          ><text
            >{{order.snapshot.address.province}}{{order.snapshot.address.city}}{{order.snapshot.address.district}}{{order.snapshot.address.detail}}</text
          ></view
        ></view
      >
      <view wx:if="{{hasCombined}}" class="jy-card jy-combined">
        <view class="jy-store"
          >本次合并提货商品<text wx:if="{{combinedPickup}}">
            · 共 {{combinedPickup.count}} 件</text
          ></view
        >
        <view wx:if="{{combinedLoading}}" class="jy-combined-note"
          >正在读取合并提货商品…</view
        >
        <view
          wx:elif="{{combinedError}}"
          class="jy-combined-error"
          role="alert"
        >
          <text>{{combinedError}}</text>
          <button bindtap="retryCombined" hover-class="jy-pressed">
            重新查询
          </button>
          <button bindtap="storage" hover-class="jy-pressed">
            查看我的寄存
          </button>
        </view>
        <block wx:elif="{{combinedPickup}}">
          <view class="jy-combined-note"
            >{{combinedPickup.statusText}} · 商品货款按原购买订单结算</view
          >
          <view
            wx:for="{{combinedPickup.lines}}"
            wx:key="id"
            class="jy-combined-line"
          >
            <view class="jy-combined-cover">
              <image
                wx:if="{{item.imageThumb}}"
                src="{{item.imageThumb}}"
                mode="aspectFit"
                lazy-load
                aria-label="{{item.name}}"
              />
              <image
                wx:else
                class="jy-combined-placeholder"
                src="/assets/figma/profile-storage.png"
                mode="aspectFit"
                aria-hidden="true"
              />
            </view>
            <view class="jy-combined-copy"
              ><view
                >{{item.name}}<text wx:if="{{item.is_gift}}"
                  >（赠品）</text
                ></view
              ><text>{{item.sku_name}} · {{item.sourceText}}</text></view
            >
            <text>×{{item.quantity}}</text>
          </view>
          <button
            class="jy-pickup-link"
            data-id="{{combinedPickup.id}}"
            bindtap="pickup"
            hover-class="jy-pressed"
          >
            <view
              ><view>查看本次提货单</view
              ><text>{{combinedPickup.number}}</text></view
            ><text aria-hidden="true">›</text>
          </button>
        </block>
      </view>
      <view class="jy-card"
        ><view class="jy-store"
          ><image src="assets/detail-imgIcon5.png" /><text
            >原订单商品 · 共 {{order.count}} 件</text
          ></view
        ><view
          wx:for="{{order.displayLines}}"
          wx:key="lineKey"
          class="jy-product"
          ><image src="{{item.imageThumb}}" mode="aspectFill" /><view
            class="jy-product-copy"
            ><view>{{item.name}}</view><text>{{item.skuName}}</text></view
          ><view class="jy-line-price"
            >{{item.priceText}}<view>×{{item.quantity}}</view></view
          ></view
        ></view
      >
      <view class="jy-card jy-info"
        ><view
          ><text>订单编号</text
          ><button bindtap="copy">{{order.number}}　复制</button></view
        ><view><text>创建时间</text><text>{{order.createdText}}</text></view
        ><view><text>付款方式</text><text>{{order.methodText}}</text></view
        ><view><text>款项状态</text><text>{{order.receiptText}}</text></view
        ><view
          ><text>收款流水</text
          ><text
            >{{payment.receipt.transaction_id||'尚无已确认流水'}}</text
          ></view
        ><view><text>配送方式</text><text>品牌仓快递</text></view
        ><view><text>商品合计</text><text>{{order.goodsText}}</text></view
        ><view><text>运费</text><text>{{order.shippingText}}</text></view
        ><view
          ><text>{{order.paid?'实付':'应付'}}</text
          ><text>{{order.amountText}}</text></view
        ><view wx:if="{{order.receivedText}}"
          ><text>收货完成</text><text>{{order.receivedText}}</text></view
        ></view
      >
      <view wx:if="{{order.status==='pending'}}" class="jy-card jy-transfer">
        <view class="jy-store">积分支付与充值说明</view>
        <view>本次应付 {{order.amountText}}，所有客户均使用积分。</view>
        <view
          >订单号：{{order.number}} <button bindtap="copy">复制</button></view
        >
        <view
          >积分不足时联系总部微信充值，核款增加积分后，再回到本单一次支付。</view
        >
        <view wx:if="{{transfer.transferNotes}}"
          >{{transfer.transferNotes}}</view
        ><view wx:if="{{transfer.customerService}}"
          >{{transfer.customerService}}</view
        >
        <view
          >{{order.locked?'历史交易结果尚未确认，请联系总部核查，勿重复操作。':order.kind==='package'?'固定权益包不可换货，成功扣积分后开通身份；充值本身不会开通。':'在下方确认积分支付后，品牌仓才安排发货或建立寄存。'}}</view
        >
      </view>
      <view wx:if="{{order.storageRemainingQty>0}}" class="jy-card jy-pickups">
        <view class="jy-store">剩余寄存 {{order.storageRemainingQty}} 件</view>
        <button class="jy-pickup-link" bindtap="storage">
          查看寄存与申请提货 ›
        </button>
      </view>
      <view wx:if="{{order.pickups.length}}" class="jy-card jy-pickups"
        ><view class="jy-store">分次配送记录</view
        ><button
          wx:for="{{order.pickups}}"
          wx:key="id"
          class="jy-pickup-link"
          data-id="{{item.id}}"
          bindtap="pickup"
          hover-class="jy-pressed"
        >
          <view><view>查看配送单</view><text>{{item.number}}</text></view
          ><text aria-hidden="true">›</text>
        </button></view
      >
      <view class="jy-contact"
        ><image src="assets/detail-imgIcon6.png" /><text
          >订单有疑问？联系专属顾问协助处理</text
        ><button bindtap="contact">联系顾问</button></view
      >
    </view>
    <view class="jy-actions">
      <block wx:if="{{order.status==='pending'}}">
        <button
          class="jy-outline"
          bindtap="cancel"
          disabled="{{busy||!order.canPay}}"
        >
          取消订单
        </button>
        <button
          wx:if="{{canUsePoints}}"
          class="jy-outline"
          bindtap="points"
          disabled="{{busy}}"
        >
          积分支付
        </button>
        <button class="jy-solid" bindtap="load" disabled="{{busy}}">
          刷新付款状态
        </button>
      </block>
      <block wx:else
        ><button
          class="jy-outline"
          bindtap="aftersales"
          disabled="{{!order.paid}}"
        >
          申请售后</button
        ><button class="jy-solid" bindtap="logistics">查看物流</button></block
      >
    </view>
  </block>
</view>
<brand-dialog id="brand-dialog" />
