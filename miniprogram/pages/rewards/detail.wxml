<view class="reward-detail"><view wx:if="{{error}}" class="state">{{error}}<button bindtap="load">重新加载</button></view><view wx:elif="{{loading}}" class="state">正在读取本人奖励…</view><block wx:elif="{{item}}"><view class="detail-top"><view>{{item.title}}</view><view class="detail-amount">¥ {{item.amount}}</view><view>{{item.statusName}} · {{item.reason}}</view></view><view class="detail-card"><view class="detail-title">原奖励与当前余额</view><view>来源订单 {{item.orderNumber}}</view><view>登记时间 {{item.createTime}}</view><view>原奖励 ¥{{item.amount}} · 已冲回 ¥{{item.reversed}}</view><view>已结算 ¥{{item.settled}} · 剩余应付 ¥{{item.remaining}}</view><view wx:if="{{item.eligibleAt}}">原售后期结束 {{item.eligibleAt}}</view></view>
<view class="detail-card"><view class="detail-title">实际退款冲回</view><view wx:if="{{!item.reversals.length}}">暂无冲回记录</view><view wx:for="{{item.reversals}}" wx:key="id" class="detail-row">退款 #{{item.refund_id}} · 冲回 ¥{{item.amount}}<view>其中已付待收回 ¥{{item.debt}}</view><view>{{item.create_time}}</view></view></view>
<view class="detail-card"><view class="detail-title">月结核实记录</view><view wx:if="{{!item.settlements.length}}">暂无结算记录；登记不代表已付款</view><view wx:for="{{item.settlements}}" wx:key="id" class="detail-row">{{item.month}} · {{item.statusName}}<view>收款人 {{item.payee}}</view><view>应付 ¥{{item.gross}} · 抵扣 ¥{{item.offset}} · 实付 ¥{{item.net}}</view><view wx:if="{{item.paid_at}}">实际核实时间 {{item.paid_at}}</view><view wx:if="{{item.proof}}" user-select>凭证 {{item.proof}}</view></view></view>
<view class="detail-card"><view class="detail-title">已付冲回待收回</view><view wx:if="{{!item.debts.length}}">暂无已付冲回欠款</view><view wx:for="{{item.debts}}" wx:key="id" class="detail-row">冲回 #{{item.id}} · 原待收回 ¥{{item.original}}<view>累计抵扣 ¥{{item.offset}} · 人工实收 ¥{{item.recovered}}</view><view class="debt">尚待收回 ¥{{item.remaining}}</view></view></view>
<view class="detail-card"><view class="detail-title">逐笔抵扣与实收</view><view wx:if="{{!item.offsets.length && !item.recoveries.length}}">暂无实际抵扣或收回</view><view wx:for="{{item.offsets}}" wx:key="id" class="detail-row">抵扣 ¥{{item.amount}}<view>原冲回 #{{item.reversal_id}} · 月结 #{{item.settlement_id}} · 本次奖励 #{{item.reward_id}}</view><view>{{item.create_time}}</view></view><view wx:for="{{item.recoveries}}" wx:key="id" class="detail-row">人工实收 ¥{{item.amount}} · 原冲回 #{{item.reversal_id}}<view>{{item.received_at}}</view><view user-select>凭证 {{item.proof}}</view></view></view><view class="detail-note">公司线下核实结算，奖励与订货积分分别记账。</view></block></view>
