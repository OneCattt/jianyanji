page {
  background: #f5f4f2;
  color: #2c221e;
}
.reward-detail {
  padding: 8px;
  font-size: 14px;
  line-height: 1.9;
  overflow-wrap: anywhere;
}
.detail-top {
  background: #fff;
  color: #2c221e;
  padding: 18px 16px;
  border-radius: 12px;
}
.detail-amount {
  font:
    56rpx/1.8 -apple-system,
    "PingFang SC",
    sans-serif;
  color: #7a1c1c;
  font-weight: 600;
  font-size: 32px;
}
.detail-card {
  background: #ffffff;
  margin-top: 10px;
  padding: 18px 16px;
  color: #796f68;
  border-radius: 12px;
}
.detail-title {
  font-size: 16px;
  color: #2c221e;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.detail-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee9e4;
}
.detail-row:last-child {
  border: 0;
}
.debt {
  color: #7a1c1c;
}
.detail-note,
.state {
  padding: 36rpx 10rpx;
  text-align: center;
  color: #796f68;
}
.state button {
  font-size: 24rpx;
  color: #7a1c1c;
}
