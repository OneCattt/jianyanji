page {
  background: #f5f4f2;
  color: #2c221e;
}
.reward-page {
  min-height: 100vh;
  background: #f5f4f2;
  font-family: "PingFang SC", sans-serif;
  padding-bottom: calc(env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.reward-page button {
  width: auto;
  min-width: 0;
  border: 0;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.5;
  font: inherit;
  color: inherit;
}
.reward-page button::after {
  border: 0;
}
.reward-summary {
  height: auto;
  padding: 18px 16px;
  background: #fff;
  color: #2c221e;
  margin: 8px;
  border-radius: 12px;
}
.estimate-label {
  padding-top: 0;
  height: auto;
  font-size: 13px;
  line-height: 26.93rpx;
  color: #796f68;
}
.estimate {
  font:
    57.85rpx/86.77rpx -apple-system,
    "PingFang SC",
    sans-serif;
  padding-top: 15.96rpx;
  color: #7a1c1c;
  font-size: 32px;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  padding-top: 20px;
  gap: 8px;
}
.metrics > view {
  display: flex;
  flex-direction: column;
  gap: 9.97rpx;
  min-width: 0;
}
.metrics > view + view {
  border-left: 1rpx solid #ffffff24;
  padding-left: 12px;
  border-color: #eee9e4;
}
.metrics text {
  color: #796f68;
  font-size: 12px;
  line-height: 23.94rpx;
}
.metrics view view {
  font:
    19.95rpx/29.92rpx -apple-system,
    "PingFang SC",
    sans-serif;
  font-size: 14px;
  overflow-wrap: anywhere;
}
.reward-tabs {
  height: auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #ffffff;
  margin: 2px 8px 0;
  border-radius: 12px;
  padding: 4px;
}
.reward-tabs button {
  padding: 10px 2px;
  font-size: 13px;
  line-height: 26.93rpx;
  color: #796f68;
  border-bottom: 0;
  min-height: 44px;
}
.reward-tabs button.active {
  color: #7a1c1c;
  border-color: #7a1c1c;
  background: #f5e9e9;
  border-radius: 24px;
}
.reward-body {
  padding: 10px 8px 0;
  flex: 1;
}
.reward-list {
  background: #ffffff;
  padding: 0 16px;
  border-radius: 12px;
}
.reward-page .reward-row {
  display: flex !important;
  gap: 21.94rpx;
  padding: 31.91rpx 0 !important;
  width: 100%;
  min-height: 155.59rpx;
  text-align: left;
  border-top: 1rpx solid #eee9e4 !important;
}
.reward-row:first-child {
  border-top: 0 !important;
}
.reward-icon {
  flex-shrink: 0;
  width: 67.82rpx;
  height: 67.82rpx;
  background: #f1dfde;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reward-icon image {
  width: 33.91rpx;
  height: 33.91rpx;
}
.reward-icon.muted {
  background: #f5f4f2;
}
.reward-source {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 9.97rpx;
}
.reward-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 29.92rpx;
}
.source-number,
.source-date {
  font-size: 12px;
  line-height: 1.6;
  color: #796f68;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.reward-value {
  display: flex;
  flex-direction: column;
  gap: 9.97rpx;
  align-items: flex-end;
  flex-shrink: 0;
  color: #7a1c1c;
}
.reward-value > view {
  font:
    bold 21.94rpx/32.91rpx -apple-system,
    "PingFang SC",
    sans-serif;
  font-size: 14px;
}
.reward-value > text {
  font-size: 11px;
  line-height: 1.6;
  color: #796f68;
}
.muted-value {
  color: #81746b;
}
.reward-footer {
  padding: 16px;
  display: flex;
  gap: 13.96rpx;
  align-items: center;
  color: #796f68;
  font-size: 12px;
  line-height: 1.7;
}
.reward-footer image {
  width: 29.92rpx;
  height: 29.92rpx;
  flex-shrink: 0;
}
.state {
  padding: 79.79rpx 10rpx;
  text-align: center;
  color: #796f68;
  font-size: 24rpx;
  line-height: 1.8;
}
.state button {
  color: #7a1c1c;
  margin-top: 20rpx;
}
.error {
  color: #7a1c1c;
}
.debt-note {
  padding: 20rpx 40rpx;
  color: #7a1c1c;
  font-size: 12px;
  line-height: 1.7;
}
