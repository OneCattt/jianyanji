/* 商品操作栏使用不透明底色，明确区分购物袋入口、加入和订货操作。 */
.qx .product-actions {
  gap: 8px;
  min-height: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: #fffdfa;
  border-top: 0.5px solid #eae4df;
}
.qx .product-actions > button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 44px;
  padding: 0 8px;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}
.qx .product-action-cart {
  flex: 0 0 64px;
  flex-direction: column;
  gap: 2px;
  border: 1px solid #d7c8bf;
  background: #faf8f5;
  color: #46332a;
}
.product-action-cart image {
  width: 18px;
  height: 18px;
}
.product-action-cart text {
  font-size: 11px;
}
.qx .product-action-add {
  flex: 1;
  border: 1px solid #8d1724;
  background: #f8ecea;
  color: #8d1724;
}
.qx .product-action-buy {
  flex: 1;
  background: #8d1724;
  color: #fff;
}
.qx .product-action-pressed {
  opacity: 0.75;
}
