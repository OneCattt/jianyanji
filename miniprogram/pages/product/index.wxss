/* 大主图、白色信息卡与酒红色操作栏沿用品牌配色。 */
.product-page {
  min-height: 100vh;
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
  background: #f5f4f2;
  color: #2c221e;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 13px;
}
.product-nav {
  position: absolute;
  left: 12px;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 44px;
  border: 0.5px solid #ffffff80;
  border-radius: 24px;
  background: #fffdfae6;
}
.product-page .product-nav button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}
.product-nav image {
  width: 21px;
  height: 21px;
}
.product-back-icon {
  width: 10px;
  height: 10px;
  margin-left: 5px;
  border-bottom: 1.8px solid #2c221e;
  border-left: 1.8px solid #2c221e;
  transform: rotate(45deg);
}
.product-nav-divider {
  width: 0.5px;
  height: 18px;
  background: #2c221e20;
}
.product-page .product-hero {
  position: relative;
  display: block;
  width: 100%;
  height: 110vw;
  background: #e9e5de;
}
.product-hero > image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.product-image-hint {
  position: absolute;
  right: 16px;
  bottom: 16px;
  padding: 5px 11px;
  border-radius: 20px;
  background: #251d1a66;
  color: #fff;
  font-size: 11px;
}
.product-content {
  padding: 10px 8px 0;
}
.product-card {
  margin-bottom: 10px;
  padding: 18px 16px;
  border-radius: 12px;
  background: #fff;
}
.product-price-label {
  display: inline-block;
  padding: 3px 7px;
  border: 0.5px solid #7a1c1c;
  border-radius: 3px;
  color: #7a1c1c;
  font-size: 11px;
  line-height: 16px;
}
.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
}
.product-price {
  min-width: 0;
  color: #7a1c1c;
  font-size: 30px;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-all;
}
.product-unit {
  color: #796f68;
  font-size: 12px;
  font-weight: 400;
  white-space: nowrap;
}
.product-page .product-overview-share {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 44px;
  min-height: 48px;
  color: #4a3a34;
  font-size: 11px;
}
.product-overview-share image {
  width: 24px;
  height: 24px;
}
.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  margin-top: 7px;
  color: #796f68;
  font-size: 12px;
  line-height: 1.6;
}
.product-retail-discounted {
  text-decoration: line-through;
}
.product-name {
  margin-top: 16px;
  font-size: 19px;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.product-subtitle {
  margin-top: 8px;
  color: #796f68;
  font-size: 13px;
  line-height: 1.7;
}
.product-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 28px;
}
.product-option-label {
  flex-shrink: 0;
  color: #796f68;
  font-size: 13px;
}
.product-selected-spec {
  min-width: 0;
  text-align: right;
}
.product-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.product-page .product-spec {
  min-height: 44px;
  padding: 10px 14px;
  border: 1px solid #e7e1dc;
  border-radius: 6px;
  background: #faf8f6;
  color: #5d5047;
  font-size: 12px;
  line-height: 22px;
}
.product-page .product-spec-selected {
  border-color: #7a1c1c;
  background: #f7eceb;
  color: #7a1c1c;
}
.product-quantity-row {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 0.5px solid #eee9e4;
}
.product-quantity {
  display: flex;
  align-items: center;
  border: 0.5px solid #e2dbd5;
  border-radius: 6px;
  overflow: hidden;
}
.product-page .product-quantity button,
.product-quantity > text {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  line-height: 1.5;
}
.product-page .product-quantity button {
  background: #faf7f4;
  color: #4a3a34;
  font-size: 18px;
}
.product-quantity > text {
  border-right: 0.5px solid #e2dbd5;
  border-left: 0.5px solid #e2dbd5;
  font-size: 14px;
}
.product-unavailable {
  margin-top: 14px;
  color: #7a1c1c;
  font-size: 12px;
  line-height: 1.7;
}
.product-agent-share {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 6px;
  padding-bottom: 6px;
  color: #796f68;
}
.product-page .product-agent-share button {
  min-height: 44px;
  color: #7a1c1c;
  font-size: 12px;
  line-height: 44px;
}
.product-agent-share button text {
  margin-left: 8px;
  font-size: 18px;
}
.product-section-title {
  padding-bottom: 14px;
  border-bottom: 0.5px solid #eee9e4;
  font-size: 16px;
  font-weight: 600;
}
.product-page .product-detail-image-button {
  display: block;
  width: 100%;
  margin-top: 16px;
}
.product-detail-image {
  display: block;
  width: 100%;
}
.product-description-text {
  padding-top: 14px;
  color: #65584e;
  font-size: 14px;
  line-height: 1.9;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}
.product-error {
  margin: 12px 8px;
  padding: 14px 16px;
  border-radius: 8px;
  background: #f7eceb;
  color: #7a1c1c;
  font-size: 13px;
  line-height: 1.7;
}
.product-page .product-error button {
  min-height: 44px;
  color: #7a1c1c;
}
.product-load-error,
.product-loading {
  margin-top: 120px;
}
.product-loading {
  padding: 24px;
  color: #796f68;
  text-align: center;
}
.product-page .product-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 0;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  border-top: 0.5px solid #eee9e4;
  background: #fff;
}
.product-shortcuts {
  display: flex;
  flex-shrink: 0;
  gap: 4px;
}
.product-page .product-shortcut {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 44px;
  min-height: 48px;
  color: #4a3a34;
  font-size: 10px;
  line-height: 1.3;
}
.product-shortcut image {
  display: block;
  width: 23px;
  height: 23px;
}
.product-cart-icon {
  position: relative;
}
.product-cart-badge {
  position: absolute;
  top: -6px;
  right: -10px;
  min-width: 16px;
  padding: 0 4px;
  border: 1.5px solid #fff;
  border-radius: 12px;
  background: #7a1c1c;
  color: #fff;
  font-size: 9px;
  line-height: 14px;
  text-align: center;
}
.product-purchase-actions {
  display: flex;
  flex: 1;
  gap: 8px;
  min-width: 0;
}
.product-page .product-purchase-actions button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 44px;
  padding: 0 8px;
  border-radius: 24px;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}
.product-page .product-action-add {
  background: #f5e9e9;
  color: #7a1c1c;
}
.product-page .product-action-buy {
  background: #7a1c1c;
  color: #fff;
}
.product-page .product-pressed {
  opacity: 0.7;
}
@media (max-width: 360px) {
  .product-page .product-actions {
    gap: 4px;
    padding-right: 8px;
    padding-left: 8px;
  }
  .product-shortcuts {
    gap: 0;
  }
  .product-purchase-actions {
    gap: 6px;
  }
  .product-page .product-purchase-actions button {
    padding: 0 4px;
    font-size: 12px;
  }
}
