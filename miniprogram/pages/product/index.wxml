<view class="qx qx-flow"><view wx:if="product"><image class="qx-detail-image" src="{{product.detailImage}}" mode="aspectFill"/><view class="qx-detail-section"><text class="qx-badge">{{sku.priceLabel}}</text><view class="qx-h1">{{product.name}}</view><view class="qx-muted">{{product.subtitle}}</view><view wx:if="{{sku.productType !== 'welfare'}}" class="qx-muted">零售价 {{sku.retailText}}</view><view class="qx-price qx-large">{{sku.priceText}} <text>/ {{sku.unit}}</text></view></view><view class="qx-detail-section"><view class="qx-label">规格</view><view class="qx-specs"><button wx:for="{{product.skus}}" wx:key="id" class="{{sku.id===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="select">{{item.name}} · {{item.unit}}</button></view><view class="qx-section-row"><text>购买数量</text><view class="qx-quantity"><button data-delta="-1" bindtap="change" disabled="{{quantity===1}}">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="change" disabled="{{quantity>=sku.stock}}">+</button></view></view><view class="qx-muted">{{sku.available ? '可用库存：'+sku.stock+sku.unit : sku.priceCents===null ? '当前身份价格尚未配置' : '该规格暂不可售'}}</view></view><view class="qx-detail-section"><button wx:if="{{!ownSalesCode}}" class="qx-text" bindtap="prepareSalesShare">代理生成销售分享</button><button wx:else class="qx-text" open-type="share">分享给顾客</button></view><view class="qx-notes"><view class="qx-caption">PRODUCT NOTES</view><view class="qx-h2">产品说明</view><view class="qx-about">{{product.description}}</view></view></view><view wx:if="error" class="error">{{error}}</view><view wx:if="product" class="qx-fixed"><button class="qx-text" bindtap="cart">购物袋</button><button class="qx-text" bindtap="add" disabled="{{!sku.available}}">加入购物袋</button><button class="qx-primary" bindtap="buy" disabled="{{!sku.available}}">立即订货</button></view></view>
