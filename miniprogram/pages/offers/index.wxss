@import "../storage/index.wxss";
/* 套餐以商品组合图为视觉主体，价格与选购入口保持商城的酒红色。 */
page {
  background: #f8f5ee;
}
.qx.offers-page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f8f5ee;
  color: #251d1a;
}
.offers-page .storage-head {
  padding: 12rpx 8rpx 20rpx;
}
.offers-page .storage-eyebrow {
  color: #9a8b81;
  font-size: 20rpx;
}
.offers-page .storage-title {
  font-family: STSong, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
}
.offers-page .storage-subtitle {
  color: #8e8178;
  font-size: 23rpx;
}
.offer-product-card {
  margin: 20rpx 0 28rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fffdfa;
}
.offer-product-gallery {
  position: relative;
  padding: 72rpx 24rpx 32rpx;
  background: #efeae3;
}
.offer-product-label {
  position: absolute;
  top: 22rpx;
  left: 24rpx;
  color: #795c4a;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}
.offer-product-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.offer-product-shot {
  position: relative;
  flex: 1;
  min-width: 0;
  max-width: 260rpx;
}
.offer-product-image,
.offer-product-placeholder {
  display: block;
  width: 100%;
  height: 220rpx;
}
.offer-product-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  border: 1rpx solid #d9cec1;
  border-radius: 8rpx;
  color: #866b59;
  font-family: STSong, "Songti SC", serif;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}
.offer-product-image-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #796b62;
  font-size: 22rpx;
}
.offer-shot-gift {
  padding: 2rpx 10rpx;
  border: 1rpx solid #cbb7a2;
  border-radius: 4rpx;
  color: #795c4a;
  font-size: 19rpx;
}
.offer-product-more {
  display: block;
  margin-top: 16rpx;
  color: #9a8b81;
  font-size: 20rpx;
  text-align: center;
}
.offer-product-body {
  padding: 28rpx;
}
.offer-product-name {
  color: #251d1a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.6;
  overflow-wrap: break-word;
}
.offer-product-count {
  display: block;
  margin-top: 8rpx;
  color: #8e8178;
  font-size: 22rpx;
  line-height: 1.6;
}
.offer-product-contents {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f8f6f2;
}
.offer-product-item {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #6d6057;
  font-size: 23rpx;
  line-height: 1.7;
}
.offer-product-item + .offer-product-item {
  margin-top: 8rpx;
}
.offer-product-item-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.offer-product-item-quantity {
  flex-shrink: 0;
  color: #9a8b81;
}
.offer-product-item-spec {
  margin-left: 10rpx;
  color: #9a8b81;
  font-size: 20rpx;
}
.offer-gift-label {
  flex-shrink: 0;
  color: #8d1724;
  font-size: 20rpx;
}
.offer-product-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}
.offer-product-price {
  flex: 1;
  min-width: 0;
  color: #8d1724;
  overflow-wrap: anywhere;
}
.offer-product-price-label {
  display: block;
  margin-bottom: 4rpx;
  color: #9a8b81;
  font-size: 20rpx;
}
.offer-product-amount {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}
.offer-product-unit {
  margin-left: 8rpx;
  font-size: 21rpx;
}
.qx.offers-page .offer-product-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 18rpx;
  min-height: 44px;
  padding: 16rpx 28rpx;
  border-radius: 8rpx;
  background: #8d1724;
  color: #fff;
  font-size: 25rpx;
  line-height: 1.5;
}
.offer-product-buy text {
  font-size: 32rpx;
  line-height: 1;
}
.offer-shopping-note {
  padding: 12rpx 16rpx;
  color: #9a8b81;
  font-size: 21rpx;
  line-height: 1.9;
  text-align: center;
}
.offers-page .offer-delivery {
  padding-top: 8rpx;
}
.offer-address-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.offer-address-copy .storage-muted {
  margin-top: 8rpx;
}
.offer-section-label {
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
}
.offer-delivery-note {
  margin-top: 16rpx;
}
.offer-price {
  margin: 16rpx 0 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #7a1c1c;
  overflow-wrap: anywhere;
}
.offer-price text {
  font-size: 24rpx;
  font-weight: 400;
}
.offer-line {
  padding: 24rpx 0;
  border-top: 1rpx solid #eee6df;
}
.offer-line-name {
  font-size: 28rpx;
  overflow-wrap: anywhere;
}
.offer-line .storage-quantity {
  margin-top: 12rpx;
  padding-top: 0;
  border-top: 0;
}
.offer-fixed-note {
  margin: 0 0 24rpx;
}
