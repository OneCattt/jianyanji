<view class="qx"><view class="qx-section"><view class="qx-caption">ABOUT QINGXIN</view><view class="qx-h1">品牌与购买说明</view><view wx:if="content"><view class="qx-h2">{{content.brandName}}</view><view class="qx-about">{{content.introduction}}</view><view class="qx-h2">客服</view><view class="qx-about">{{content.customerService || '客服资料尚未配置'}}</view><view class="qx-h2">购买说明</view><view class="qx-about">{{content.purchaseNotes || '购买说明尚未配置'}}</view><view class="qx-h2">公司收款资料</view><view class="qx-about">{{content.companyName ? '户名：'+content.companyName+'\n开户行：'+content.bankName+'\n账号：'+content.bankAccount : '公司收款资料尚未配置'}}</view><view class="qx-about">{{content.transferNotes || '转款说明尚未配置'}}</view><view class="qx-muted">转款到账须经品牌方核实，请按实际业务用途转款。</view></view><view wx:else class="qx-empty">{{error || '品牌资料尚未配置'}}</view></view></view>
