<view class="mine">
  <view
    class="mine-header"
    style="padding-top:{{headerTop}}px;height:{{headerHeight}}px;"
  >
    <button
      class="mine-avatar"
      data-key="settings"
      bindtap="onNavigate"
      disabled="{{navigating}}"
      aria-label="个人资料与登录设置"
    >
      {{avatarText}}
    </button>
    <view class="mine-identity">
      <view class="mine-membership">清欣会员</view>
      <button
        class="mine-name"
        data-key="settings"
        bindtap="onNavigate"
        disabled="{{navigating}}"
      >
        {{user ? user.nickname : '登录清欣'}}
      </button>
      <view class="mine-role"
        ><view class="mine-role-dot"></view
        ><text
          >{{busy ? '正在读取身份…' : user ? user.identityName + ' · ID ' +
          user.id : '欢迎，新朋友'}}</text
        ></view
      >
    </view>
    <button
      class="mine-settings"
      data-key="settings"
      bindtap="onNavigate"
      disabled="{{navigating}}"
      aria-label="设置"
    >
      •••
    </button>
  </view>
  <view class="mine-content">
    <view wx:if="{{user}}" class="mine-wallet">
      <view class="mine-wallet-head"
        ><view class="mine-wallet-label"
          ><image
            src="/assets/figma/profile-wallet.png"
            mode="aspectFit"
          /><text>积分钱包</text></view
        ><text class="mine-wallet-hint"
          >{{!walletLoaded ? '可用积分以实际记录为准' : transferConfigured ?
          '总部核实微信充值后增加积分' : '总部联系方式尚未配置'}}</text
        ></view
      >
      <view class="mine-balance"
        ><text class="mine-balance-label">可用积分</text
        ><view class="mine-balance-row"
          ><text class="mine-balance-number">{{availablePoints}}</text
          ><button
            class="mine-wallet-detail"
            hover-class="mine-wallet-detail-active"
            data-key="wallet"
            bindtap="onNavigate"
            disabled="{{navigating}}"
          >
            <text>积分明细</text
            ><text class="mine-wallet-detail-arrow" aria-hidden="true">›</text>
          </button></view
        ></view
      >
      <view wx:if="{{walletError}}" class="mine-inline-error"
        ><text>{{walletError}}</text
        ><button bindtap="refresh" disabled="{{busy}}">重试</button></view
      >
    </view>
    <view wx:else class="mine-welcome">
      <view class="mine-welcome-title"
        >{{user ? '欢迎来到清欣' : '与美好肌肤相遇'}}</view
      ><view class="mine-welcome-copy"
        >{{user ? '普通顾客可微信充值积分后购物，也可购买店主权益包。' :
        '登录后查看订单、管理资料，开启清欣之旅。'}}</view
      >
      <view class="mine-wallet-actions"
        ><button class="mine-solid" bindtap="toMall" disabled="{{navigating}}">
          臻选商城</button
        ><button
          class="mine-outline"
          data-key="{{user ? 'onboarding' : 'settings'}}"
          bindtap="onNavigate"
          disabled="{{navigating}}"
        >
          {{user ? '代理入驻' : '登录清欣'}}
        </button></view
      >
    </view>
    <view wx:for="{{packageProgress}}" wx:key="id" class="mine-package-progress"
      ><view class="mine-progress-heading"
        ><text>{{item.target_identity==='B'?'19800':'2980'}}店主权益包</text
        ><text
          >{{item.consumption_confirmed?'总部已确认完成':'收货进度'}}</text
        ></view
      ><view class="mine-progress-count"
        >已收货 <text>{{item.consumed_qty}}</text> / {{item.total_qty}} 件</view
      ></view
    >
    <view wx:if="{{error}}" class="mine-error"
      ><text>{{error}}</text
      ><button bindtap="refresh" disabled="{{busy}}">重试</button></view
    >
    <view class="mine-orders">
      <view class="mine-orders-head"
        ><text class="mine-section-title">我的订单</text
        ><button
          class="mine-all-orders"
          data-key="orders"
          bindtap="onNavigate"
          disabled="{{navigating}}"
        >
          <text>全部订单</text
          ><image
            src="/assets/figma/profile-arrow.png"
            mode="aspectFit"
          /></button
      ></view>
      <view class="mine-order-grid"
        ><button
          wx:for="{{orderShortcuts}}"
          wx:key="tab"
          class="mine-order-shortcut"
          data-key="orders"
          data-tab="{{item.tab}}"
          aria-label="{{item.name + (item.icon !== 'completed' && orderCounts && orderCounts[item.icon] > 0 ? '，' + orderCounts[item.icon] + '笔订单' : '')}}"
          bindtap="onNavigate"
          disabled="{{navigating}}"
        >
          <view class="mine-order-icon">
            <image
              src="/assets/figma/profile-order-{{item.icon}}.png"
              mode="aspectFit"
            />
            <text
              wx:if="{{item.icon !== 'completed' && orderCounts && orderCounts[item.icon] > 0}}"
              class="qx-count-badge mine-order-badge"
              aria-hidden="true"
              >{{orderCounts[item.icon] > 99 ? '99+' :
              orderCounts[item.icon]}}</text
            > </view
          ><text>{{item.name}}</text>
        </button></view
      >
      <view wx:if="{{orderCountsError}}" class="mine-count-error">
        <text>{{orderCountsError}}</text>
        <button bindtap="loadOrderCounts">重试</button>
      </view>
    </view>
    <view class="mine-menu">
      <block wx:for="{{menuItems}}" wx:key="key">
        <block
          wx:if="{{(!item.agentOnly || isAgent) && (!item.principalOnly || (user && user.identity==='B'))}}"
        >
          <button
            wx:if="{{item.key === 'invite'}}"
            class="mine-menu-item"
            open-type="share"
            disabled="{{navigating}}"
          >
            <view class="mine-menu-icon"
              ><image
                src="/assets/figma/profile-share.png"
                mode="aspectFit" /></view
            ><text class="mine-menu-title">{{item.title}}</text
            ><text class="mine-menu-hint">{{item.hint}}</text
            ><image
              class="mine-menu-arrow"
              src="/assets/figma/profile-arrow.png"
              mode="aspectFit"
            />
          </button>
          <button
            wx:else
            class="mine-menu-item"
            data-key="{{item.key}}"
            bindtap="onNavigate"
            disabled="{{navigating}}"
          >
            <view class="mine-menu-icon"
              ><image
                src="/assets/figma/profile-{{item.icon}}.png"
                mode="aspectFit" /></view
            ><text class="mine-menu-title">{{item.title}}</text
            ><text class="mine-menu-hint">{{item.hint}}</text
            ><image
              class="mine-menu-arrow"
              src="/assets/figma/profile-arrow.png"
              mode="aspectFit"
            />
          </button>
        </block>
      </block>
    </view>
    <button
      wx:if="{{isAgent}}"
      class="mine-copy-invite"
      bindtap="copyInvite"
      disabled="{{busy}}"
    >
      复制我的入驻邀请路径
    </button>
    <view class="mine-footer">品牌仓统一发货 · 正品溯源 · 专属售后保障</view>
  </view>
</view>

<login-sheet id="login-sheet" />
