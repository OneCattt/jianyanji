.wallet-page {
  min-height: 100vh;
  background: #f2ece4;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.wallet-card {
  margin: 24rpx;
  padding: 32rpx;
  min-height: 320rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 95% 10%, #c2776359, transparent 37%), #59131b;
  color: white;
}
.wallet-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
}
.wallet-card-row > text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #eadbd1;
}
.qx .wallet-card-row button {
  flex: none;
  width: auto;
  min-width: 88px;
  min-height: 44px;
  color: #eadbd1;
  border: 1.995rpx solid #ffffff5c;
  line-height: 1.5;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
}
.wallet-amount {
  font:
    64rpx/1.25 Georgia,
    serif;
  color: #f6e9dc;
  margin-top: 24rpx;
  overflow-wrap: break-word;
  word-break: break-all;
}
.wallet-totals {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.wallet-totals > view {
  flex: 1;
  min-width: 0;
}
.wallet-totals text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #eadbd1;
  display: block;
  margin-bottom: 9.973rpx;
}
.wallet-totals view > view {
  font:
    600 28rpx/1.5 Georgia,
    serif;
  color: white;
  overflow-wrap: break-word;
  word-break: break-all;
}
.wallet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 32.912rpx;
}
.qx .wallet-heading button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  width: auto;
  min-width: 88px;
  min-height: 44px;
  font-size: 24rpx;
  color: #8e8178;
  font-weight: 400;
}
.wallet-ledger {
  background: #fffdfa;
  margin: 0 24rpx;
  padding: 0 24rpx;
}
.wallet-entry {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx 0;
  min-height: 136rpx;
  border-top: 1.995rpx solid #4530261f;
}
.wallet-entry:first-child {
  border-top: 0;
}
.wallet-icon {
  width: 56rpx;
  height: 56rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: #eee4d8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.wallet-icon.positive {
  background: #f1dfde;
}
.wallet-icon image {
  width: 31.915rpx;
  height: 31.915rpx;
}
.wallet-copy {
  flex: 1;
  min-width: 0;
}
.wallet-entry-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-bottom: 8rpx;
}
.wallet-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}
.wallet-entry-source,
.wallet-entry-date {
  display: block;
  color: #786a62;
  font-size: 24rpx;
  line-height: 1.6;
}
.wallet-entry-source {
  overflow-wrap: break-word;
  word-break: break-all;
}
.wallet-entry-date {
  margin-top: 4rpx;
}
.wallet-delta {
  font:
    28rpx/1.5 Georgia,
    serif;
  white-space: nowrap;
  flex-shrink: 0;
  color: #251d1a;
}
.wallet-delta.credit {
  color: #8d1724;
}
.wallet-audit {
  display: flex;
  gap: 15.957rpx;
  align-items: flex-start;
  padding: 23.936rpx 35.904rpx;
}
.wallet-audit image {
  width: 35.904rpx;
  height: 35.904rpx;
  flex-shrink: 0;
}
.wallet-audit text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8e8178;
}
.qx .wallet-cash {
  font-size: 28rpx;
  color: #8d1724;
  text-align: left;
  padding: 23.936rpx 35.904rpx;
}
.wallet-bottom-note {
  font-size: 24rpx;
  line-height: 1.8;
  color: #8e8178;
  padding: 0 35.904rpx;
}
.wallet-empty {
  padding: 79.787rpx 23.936rpx;
  text-align: center;
  color: #8e8178;
  font-size: 21.941rpx;
}
.wallet-error {
  font-size: 21.941rpx;
  color: #a52b37;
  padding: 23.936rpx 35.904rpx;
  line-height: 1.8;
}
.wallet-error button {
  font-size: 21.941rpx;
  color: #8d1724;
  text-align: left;
}
.wallet-payment {
  background: #fffdfa;
  margin: 27.926rpx;
  padding: 31.915rpx;
}
.wallet-section-title {
  font:
    31.915rpx/47.872rpx STSong,
    "Songti SC",
    serif;
  letter-spacing: 1.995rpx;
}
.wallet-source {
  font-size: 17.952rpx;
  line-height: 1.8;
  color: #8e8178;
  overflow-wrap: anywhere;
  margin-top: 9.973rpx;
}
.wallet-payment-row {
  display: flex;
  justify-content: space-between;
  font-size: 21.941rpx;
  margin: 31.915rpx 0;
}
.wallet-payment-row text:last-child {
  font-family: Georgia, serif;
  color: #8d1724;
}
.qx .wallet-primary {
  padding: 23.936rpx;
  background: #8d1724;
  color: white;
  font-size: 21.941rpx;
  text-align: center;
  width: 100%;
  margin-top: 19.947rpx;
}
.wallet-payment-note {
  font-size: 17.952rpx;
  line-height: 1.8;
  color: #8e8178;
  margin-top: 23.936rpx;
}
.wallet-paid {
  font-size: 21.941rpx;
  color: #8d1724;
  line-height: 1.8;
}
.wallet-mask {
  position: fixed;
  inset: 0;
  background: #1f14118c;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(7.979rpx);
}
.wallet-transfer {
  width: 100%;
  background: #f8f5ee;
  border-radius: 47.872rpx 47.872rpx 0 0;
  padding: 55.851rpx 39.894rpx calc(47.872rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}
.wallet-bank {
  font-size: 25.931rpx;
  line-height: 1.8;
  margin-top: 31.915rpx;
}
.wallet-account {
  font:
    31.915rpx/1.6 Georgia,
    serif;
  color: #8d1724;
  overflow-wrap: anywhere;
  margin: 19.947rpx 0;
}
.wallet-transfer-notes {
  font-size: 21.941rpx;
  color: #786a62;
  line-height: 1.9;
  white-space: pre-line;
}

.wallet-chevron {
  width: 25.931rpx;
  height: 25.931rpx;
  vertical-align: middle;
}
