.wallet-page {
  min-height: 100vh;
  background: #f5f4f2;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.wallet-card {
  margin: 8px;
  padding: 18px 16px;
  min-height: 320rpx;
  box-sizing: border-box;
  background: #fff;
  color: #2c221e;
  border-radius: 12px;
}
.wallet-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
}
.wallet-card-row > text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #796f68;
}
.qx .wallet-card-row button {
  flex: none;
  width: auto;
  min-width: 88px;
  min-height: 44px;
  color: #7a1c1c;
  border: 0;
  line-height: 1.5;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 24px;
  background: #f5e9e9;
}
.wallet-amount {
  font:
    64rpx/1.25 -apple-system,
    "PingFang SC",
    sans-serif;
  color: #7a1c1c;
  margin-top: 24rpx;
  overflow-wrap: break-word;
  word-break: break-all;
  font-weight: 600;
}
.wallet-totals {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.wallet-totals > view {
  flex: 1;
  min-width: 0;
}
.wallet-totals text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #796f68;
  display: block;
  margin-bottom: 9.973rpx;
}
.wallet-totals view > view {
  font:
    600 28rpx/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  color: #2c221e;
  overflow-wrap: break-word;
  word-break: break-all;
}
.wallet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 32.912rpx;
}
.qx .wallet-heading button {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  width: auto;
  min-width: 88px;
  min-height: 44px;
  font-size: 24rpx;
  color: #796f68;
  font-weight: 400;
}
.wallet-ledger {
  background: #ffffff;
  margin: 0 8px;
  padding: 0 16px;
  border-radius: 12px;
}
.wallet-entry {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 28rpx 0;
  min-height: 136rpx;
  border-top: 1.995rpx solid #eee9e4;
}
.wallet-entry:first-child {
  border-top: 0;
}
.wallet-icon {
  width: 56rpx;
  height: 56rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: #f5f4f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.wallet-icon.positive {
  background: #f1dfde;
}
.wallet-icon image {
  width: 31.915rpx;
  height: 31.915rpx;
}
.wallet-copy {
  flex: 1;
  min-width: 0;
}
.wallet-entry-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-bottom: 8rpx;
}
.wallet-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}
.wallet-entry-source,
.wallet-entry-date {
  display: block;
  color: #796f68;
  font-size: 24rpx;
  line-height: 1.6;
}
.wallet-entry-source {
  overflow-wrap: break-word;
  word-break: break-all;
}
.wallet-entry-date {
  margin-top: 4rpx;
}
.wallet-delta {
  font:
    28rpx/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  white-space: nowrap;
  flex-shrink: 0;
  color: #2c221e;
}
.wallet-delta.credit {
  color: #7a1c1c;
}
.wallet-audit {
  display: flex;
  gap: 15.957rpx;
  align-items: flex-start;
  padding: 23.936rpx 35.904rpx;
}
.wallet-audit image {
  width: 35.904rpx;
  height: 35.904rpx;
  flex-shrink: 0;
}
.wallet-audit text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #796f68;
}
.qx .wallet-cash {
  font-size: 28rpx;
  color: #7a1c1c;
  text-align: left;
  padding: 23.936rpx 35.904rpx;
}
.wallet-bottom-note {
  font-size: 24rpx;
  line-height: 1.8;
  color: #796f68;
  padding: 0 35.904rpx;
}
.wallet-empty {
  padding: 79.787rpx 23.936rpx;
  text-align: center;
  color: #796f68;
  font-size: 21.941rpx;
}
.wallet-error {
  font-size: 21.941rpx;
  color: #a52b37;
  padding: 23.936rpx 35.904rpx;
  line-height: 1.8;
}
.wallet-error button {
  font-size: 21.941rpx;
  color: #7a1c1c;
  text-align: left;
}
.wallet-section-title {
  font:
    31.915rpx/47.872rpx -apple-system,
    "PingFang SC",
    sans-serif;
  letter-spacing: 0;
  font-size: 18px;
  font-weight: 600;
}
.wallet-source {
  font-size: 12px;
  line-height: 1.8;
  color: #796f68;
  overflow-wrap: anywhere;
  margin-top: 9.973rpx;
}
.qx .wallet-primary {
  padding: 12px;
  background: #7a1c1c;
  color: white;
  font-size: 14px;
  text-align: center;
  width: 100%;
  margin-top: 19.947rpx;
  min-height: 44px;
  border-radius: 24px;
}
.wallet-mask {
  position: fixed;
  inset: 0;
  background: #1f14118c;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(7.979rpx);
}
.wallet-transfer {
  width: 100%;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding: 24px 16px calc(24px + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}
.wallet-bank {
  font-size: 25.931rpx;
  line-height: 1.8;
  margin-top: 31.915rpx;
}
.wallet-account {
  font:
    31.915rpx/1.6 -apple-system,
    "PingFang SC",
    sans-serif;
  color: #7a1c1c;
  overflow-wrap: anywhere;
  margin: 19.947rpx 0;
}
.wallet-transfer-notes {
  font-size: 21.941rpx;
  color: #796f68;
  line-height: 1.9;
  white-space: pre-line;
}

.wallet-chevron {
  width: 25.931rpx;
  height: 25.931rpx;
  vertical-align: middle;
}

/* 订单付款专注本单金额与余额，流水由独立入口查看。 */
.wallet-payment-page {
  padding: 0 24rpx calc(120px + env(safe-area-inset-bottom));
}
.payment-summary {
  padding: 48rpx 16rpx 40rpx;
  text-align: center;
}
.payment-status {
  color: #5f544e;
  font-size: 28rpx;
  line-height: 1.6;
}
.payment-amount {
  margin-top: 16rpx;
  color: #7a1c1c;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.payment-unit {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 400;
}
.payment-caption {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #796f68;
}
.payment-method,
.payment-details {
  margin-bottom: 24rpx;
  padding: 20rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
}
.payment-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44px;
  font-size: 28rpx;
  font-weight: 600;
}
.payment-method-name {
  color: #7a1c1c;
  font-size: 26rpx;
  font-weight: 500;
}
.payment-balance,
.payment-detail-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.payment-balance > text:first-child,
.payment-detail-row > text:first-child {
  color: #796f68;
  flex-shrink: 0;
}
.payment-balance > text:last-child {
  font-weight: 600;
  font-size: 30rpx;
}
.payment-detail-row > text:last-child {
  min-width: 0;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.payment-order-number {
  font-size: 24rpx;
}
.payment-balance-note {
  margin-top: 8rpx;
  color: #796f68;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: right;
}
.payment-shortfall {
  color: #a52b37;
}
.payment-recharge-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1px solid #eee9e4;
  color: #796f68;
  font-size: 24rpx;
}
.qx .payment-card-heading button,
.qx .payment-recharge-row button,
.qx .payment-ledger-link {
  min-height: 44px;
  min-width: 88px;
  color: #7a1c1c;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
}
.qx .payment-card-heading button {
  text-align: right;
}
.payment-help {
  padding: 0 16rpx;
  color: #796f68;
  font-size: 24rpx;
  line-height: 1.8;
}
.qx .payment-ledger-link {
  display: block;
  margin: 12rpx auto 0;
  text-align: center;
}
.payment-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  padding: 16px 24rpx calc(16px + env(safe-area-inset-bottom));
  border-top: 1px solid #eee9e4;
  background: #fff;
}
.qx .payment-dock .wallet-primary {
  margin-top: 0;
  padding: 14px 16px;
  min-height: 48px;
  border-radius: 28px;
}
.payment-loading {
  padding: 120rpx 24rpx;
  color: #796f68;
  text-align: center;
  line-height: 1.8;
}
