<import src="../../templates/list-footer.wxml" />
<view class="qx wallet-page {{paymentMode?'wallet-payment-page':''}}">
  <view wx:if="{{error}}" class="wallet-error" role="alert"
    >{{error}}<button wx:if="{{!user}}" bindtap="login">
      登录 / 查看个人资料 ›</button
    ><button wx:else bindtap="load">重新查询 ›</button></view
  >
  <block wx:if="{{paymentMode}}">
    <block wx:if="{{order}}">
      <view wx:if="{{navigationFailed}}" class="payment-navigation-error">
        <text>{{paid ? '付款成功，页面跳转失败' : '订单状态已更新，页面跳转失败'}}</text>
        <view>
          <button bindtap="retryNavigate" disabled="{{busy}}">
            {{paid ? '查看订单与配送' : '查看订单状态'}}
          </button>
          <button bindtap="myOrders">我的订单</button>
        </view>
      </view>
      <view class="payment-summary">
        <view wx:if="{{isPackage}}" class="payment-kind">入驻权益包付款</view>
        <view class="payment-status">{{paymentStatusText}}</view>
        <view class="payment-amount"
          ><text>{{order.totalText}}</text
          ><text class="payment-unit">积分</text></view
        >
        <view class="payment-caption">{{paymentCaptionText}}</view>
      </view>
      <view class="payment-method">
        <view class="payment-card-heading"
          ><text>支付方式</text
          ><text class="payment-method-name">积分余额</text></view
        >
        <view class="payment-balance"
          ><text>可用积分</text
          ><text>{{wallet?wallet.availableText:'—'}}</text></view
        >
        <view
          wx:if="{{!paid&&canPay}}"
          class="payment-balance-note {{insufficient?'payment-shortfall':''}}"
          ><block wx:if="{{insufficient}}"
            >还差 {{shortfallText}} 积分，充值到账后可继续付款</block
          ><block wx:else>支付后剩余 {{afterPayText}} 积分</block></view
        >
        <view
          wx:if="{{!paid&&canPay&&insufficient}}"
          class="payment-recharge-row"
          ><text>总部核款后到账</text
          ><button bindtap="load" disabled="{{busy||paymentLoading}}">
            {{paymentLoading?'查询中…':'已充值，刷新余额'}}
          </button></view
        >
      </view>
      <view class="payment-details">
        <view class="payment-card-heading"
          ><text>订单信息</text
          ><button wx:if="{{!paid}}" bindtap="order">查看订单 ›</button></view
        >
        <view class="payment-detail-row"
          ><text>订单类型</text
          ><text>{{order.kind==='package'?'入驻权益包':'商品订单'}}</text></view
        >
        <view
          wx:if="{{isPackage && order.identityText}}"
          class="payment-detail-row"
          ><text>入驻身份</text><text>{{order.identityText}}</text></view
        >
        <view class="payment-detail-row"
          ><text>订单编号</text
          ><text class="payment-order-number" user-select="true"
            >{{order.number}}</text
          ></view
        >
        <view wx:if="{{isPackage}}" class="payment-detail-row"
          ><text>所需积分</text><text>{{order.totalText}}</text></view
        >
        <view class="payment-detail-row"
          ><text>商品积分</text><text>{{order.goodsPointsText}}</text></view
        >
        <view class="payment-detail-row"
          ><text>运费积分</text><text>{{order.shippingPointsText}}</text></view
        >
        <view wx:if="{{isPackage}}" class="payment-detail-row"
          ><text>交付安排</text><text>{{order.deliveryText}}</text></view
        >
        <view
          wx:if="{{isPackage && order.addressText}}"
          class="payment-detail-row"
          ><text>收货信息</text><text>{{order.addressText}}</text></view
        >
        <view wx:if="{{order.expiresText && !paid}}" class="payment-detail-row"
          ><text>支付截止</text><text>{{order.expiresText}}</text></view
        >
      </view>
      <view class="payment-help">{{paymentHelpText}}</view>
      <button class="payment-ledger-link" bindtap="walletDetails">
        查看积分明细 ›
      </button>
      <button
        wx:if="{{paid && isPackage}}"
        class="payment-back-link"
        bindtap="back"
      >
        返回入驻页
      </button>
      <view class="payment-dock">
        <button wx:if="{{paid}}" class="wallet-primary" bindtap="order">
          {{isPackage?'查看商品交付订单':'查看订单与配送'}}
        </button>
        <button
          wx:elif="{{canPay&&insufficient}}"
          class="wallet-primary"
          bindtap="transfer"
          disabled="{{busy||paymentLoading}}"
        >
          联系总部充值
        </button>
        <button
          wx:elif="{{canPay||paymentLoading}}"
          class="wallet-primary"
          bindtap="pay"
          disabled="{{busy||!canPay||paymentLoading}}"
          loading="{{busy}}"
        >
          <block wx:if="{{busy}}">积分扣减中…</block
          ><block wx:elif="{{paymentLoading}}">正在核对…</block
          ><block wx:else>确认支付 {{order.totalText}} 积分</block>
        </button>
        <button wx:else class="wallet-primary" bindtap="order">
          查看订单状态
        </button>
      </view>
    </block>
    <view wx:else class="payment-loading"
      >{{paymentLoading?'正在加载订单与积分余额…':'订单信息暂不可用，请重新查询'}}</view
    >
  </block>
  <block wx:else>
    <view class="wallet-card">
      <view class="wallet-card-row"
        ><text>可用积分</text><button bindtap="transfer">微信充值</button></view
      >
      <view class="wallet-amount">{{wallet?wallet.availableText:'—'}}</view>
      <view class="wallet-totals"
        ><view
          ><text>累计发放</text
          ><view>{{wallet?wallet.creditedText:'—'}}</view></view
        ><view
          ><text>累计使用</text
          ><view>{{wallet?wallet.spentText:'—'}}</view></view
        ><view wx:if="{{wallet&&wallet.heldCents}}"
          ><text>办理中占用</text><view>{{wallet.heldText}}</view></view
        ></view
      >
    </view>
    <view class="wallet-heading"
      ><text>积分流水</text
      ><button bindtap="filter">
        {{filterName}}
        <image class="wallet-chevron" src="assets/chevron.png" /></button
    ></view>
    <view class="wallet-ledger">
      <view
        wx:for="{{ledger}}"
        wx:key="id"
        class="wallet-entry"
        data-id="{{item.order_id}}"
        bindtap="ledgerOrder"
        ><view class="wallet-icon {{item.delta_cents>0?'positive':''}}"
          ><image src="assets/{{item.icon}}.png" /></view
        ><view class="wallet-copy"
          ><view class="wallet-entry-head"
            ><text class="wallet-entry-title">{{item.title}}</text
            ><text class="wallet-delta {{item.delta_cents>0?'credit':''}}"
              >{{item.deltaText}}</text
            ></view
          ><text class="wallet-entry-source">{{item.source}}</text
          ><text class="wallet-entry-date">{{item.dateText}}</text></view
        ></view
      >
      <view
        wx:if="{{!ledger.length && !ledgerLoading && !error}}"
        class="wallet-empty"
        >{{wallet?'暂无该类型积分流水':'登录后查询本人真实积分流水'}}</view
      >
    </view>
    <template
      wx:if="{{ledgerLoading||ledger.length||error}}"
      is="list-footer"
      data="{{loading:ledgerLoading,loaded:ledgerLoaded,hasMore:ledgerHasMore,error:error}}"
    />
    <view class="wallet-audit"
      ><image src="assets/shield.png" /><text
        >每笔发放、扣减与退回均关联原收款或订单流水，不可随意修改</text
      ></view
    >
    <button class="wallet-cash" bindtap="cashRefunds">
      现金退款办理记录 ›
    </button>
    <view class="wallet-bottom-note"
      >未用积分对应款项须经客服审核，由财务线下退款并登记；实际退款成功后扣回对应积分。奖励与积分分别记账。</view
    >
  </block>
  <view wx:if="{{showTransfer}}" class="wallet-mask" bindtap="closeTransfer"
    ><view class="wallet-transfer" catchtap="stop"
      ><view class="wallet-section-title">向微信充值 · 核实后发积分</view
      ><view wx:if="{{wallet&&wallet.transfer.configured}}"
        ><view class="wallet-bank">{{wallet.transfer.companyName}}</view
        ><view class="wallet-source">联系总部私域微信充值</view
        ><view class="wallet-account"
          >{{wallet.transfer.customerService}}</view
        ></view
      ><view wx:else class="wallet-bank"
        >公司收款资料尚未配置，请联系品牌方核实</view
      ><view class="wallet-transfer-notes"
        ><view
          >核款昵称：{{user && user.nickname !== '微信用户' ? user.nickname :
          '待完善'}} · 联系电话：{{user.phone || '待绑定'}}</view
        >
        <view>请向总部提供昵称、手机号和转账流水，双重核对后录入积分。</view>
        <button bindtap="completeProfile">查看或完善核款资料</button>
        {{wallet?wallet.transfer.transferNotes:''}}<view
          >{{wallet?wallet.transfer.customerService:''}}</view
        ><view
          >所有登录客户均可办理。1 元对应 1
          积分，不赠送、不过期。请保留微信转账流水，由总部核款录入；商品、权益包及运费均扣积分，充值本身不开通身份。</view
        ><view wx:if="{{isPackage}}"
          >请先由总部核款增加积分，再回到本单手动确认支付；充值本身不开通身份。</view
        ></view
      ><button class="wallet-primary" bindtap="closeTransfer">
        我已了解，联系品牌方核实
      </button></view
    ></view
  >
</view>
<brand-dialog id="brand-dialog" />

<login-sheet id="login-sheet" />
