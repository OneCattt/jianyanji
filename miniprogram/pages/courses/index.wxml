<view class="qx qx-flow"><view class="qx-flow-content"><view class="qx-sheet"><view class="qx-h2">课程与成长权益</view><view class="qx-about">了解各身份课程介绍与成长权益，按品牌方指引联系咨询或报名。</view><view wx:if="{{!loggedIn}}" class="qx-notice">登录后可查看当前身份对应权益。<button class="qx-text" bindtap="login">登录查看本人权益</button></view><view wx:if="{{current}}" class="qx-notice">{{current.configured?'当前可享：'+current.rights.title:'当前身份尚未配置课程权益'}}</view><view wx:if="{{mineError}}" class="error">{{mineError}}</view></view><view wx:if="{{loading}}" class="qx-empty">正在读取课程权益…</view><view wx:for="{{rights}}" wx:key="identity" class="qx-sheet"><view class="qx-badge">{{item.identityName}} {{current.identity===item.identity?'· 当前身份':''}}</view><view class="qx-label">{{item.title}}</view><view class="course-text">{{item.introduction}}</view><view wx:for="{{item.benefits}}" wx:for-item="benefit" wx:key="*this" class="qx-info-row">{{benefit}}</view><view class="course-text">{{item.enrollmentGuide}}</view><view class="qx-muted">{{item.contact}}</view><button class="qx-primary" data-contact="{{item.contact}}" bindtap="copy">复制联系 / 报名方式</button></view><view wx:if="{{!rights.length && !loading}}" class="qx-empty">课程权益尚未配置</view><view wx:if="{{error}}" class="error">{{error}}</view></view></view>
