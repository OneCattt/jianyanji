.page {
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #352b2b;
  background: #f8f6f3;
  min-height: 100vh;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.heading {
  font-weight: 600;
  margin-bottom: 18rpx;
}
.card {
  background: white;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
.order {
  padding: 14rpx 0;
  border-top: 1rpx solid #eee;
}
