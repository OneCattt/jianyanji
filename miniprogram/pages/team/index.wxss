.page {
  padding: 20px 8px calc(24px + env(safe-area-inset-bottom));
  color: #2c221e;
  background: #f5f4f2;
  min-height: 100vh;
}
.title {
  font-size: 22px;
  font-weight: 600;
  margin: 0 8px 16px;
}
.heading {
  font-weight: 600;
  margin-bottom: 18rpx;
}
.card {
  background: white;
  padding: 18px 16px;
  border-radius: 12px;
  font-size: 14px;
  line-height: 1.8;
  margin: 0 0 10px;
  overflow-wrap: anywhere;
}
.order {
  padding: 12px 0;
  border-top: 1rpx solid #eee9e4;
}
