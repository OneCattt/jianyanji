<import src="../../templates/list-footer.wxml" />
<view class="qx"
  ><view class="qx-section"
    ><button
      wx:for="{{items}}"
      wx:key="id"
      class="seed-card"
      data-id="{{item.id}}"
      bindtap="open"
      aria-label="阅读{{item.title}}"
    >
      <image
        class="seed-cover"
        src="{{item.coverDisplay}}"
        mode="aspectFill"
        lazy-load
      /><view class="seed-copy"
        ><view class="qx-badge"
          >{{item.type==='video'?'短视频':'品牌图文'}}</view
        ><view class="qx-label">{{item.title}}</view
        ><view class="qx-muted">{{item.summary}}</view></view
      >
    </button>
    <view
      wx:if="{{loaded && !items.length && !loading && !error}}"
      class="seed-empty"
    >
      <view class="seed-empty-art" aria-hidden="true">
        <view class="seed-empty-halo"></view>
        <image
          class="seed-empty-icon"
          src="/assets/figma/tab-seed-active.png"
          mode="aspectFit"
        />
      </view>
      <view class="seed-empty-title">品牌内容正在准备中</view>
      <view class="seed-empty-desc"
        >护理知识、产品使用与短视频即将上线，稍后再来看看</view
      >
      <button
        class="seed-empty-action"
        bindtap="retry"
        hover-class="seed-empty-action-pressed"
        >刷新看看</button
      >
    </view><view wx:if="{{error}}" class="error"
      >{{error}}<button class="qx-text" bindtap="retry">重试</button></view
    >
    <template
      wx:if="{{loading||items.length||error}}"
      is="list-footer"
      data="{{loading:loading,loaded:loaded,hasMore:nextBefore,error:error}}" /></view
></view>
