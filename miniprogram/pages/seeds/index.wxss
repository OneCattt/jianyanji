.qx .seed-card {
  width: 100%;
  padding: 0;
  margin: 0 0 10px;
  border-radius: 12px;
  overflow: hidden;
  text-align: left;
  background: #ffffff;
  color: inherit;
  line-height: 1.7;
}
.seed-card::after {
  border: 0;
}
.seed-cover {
  display: block;
  width: 100%;
  height: 360rpx;
}
.seed-copy {
  padding: 16px;
  white-space: normal;
}
.seed-copy .qx-label {
  font-size: 16px;
  line-height: 1.6;
}
.qx-section > .qx-about {
  margin: 8px 0 20px;
}
