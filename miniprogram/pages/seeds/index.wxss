.qx .seed-card {
  width: 100%;
  padding: 0;
  margin: 0 0 10px;
  border-radius: 12px;
  overflow: hidden;
  text-align: left;
  background: #ffffff;
  color: inherit;
  line-height: 1.7;
}
.seed-card::after {
  border: 0;
}
.seed-cover {
  display: block;
  width: 100%;
  height: 360rpx;
}
.seed-copy {
  padding: 16px;
  white-space: normal;
}
.seed-copy .qx-label {
  font-size: 16px;
  line-height: 1.6;
}
.seed-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72px 24px 48px;
  text-align: center;
}
.seed-empty-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104px;
  height: 104px;
  margin-bottom: 18px;
}
.seed-empty-halo {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 45%,
    #eee2d7 0%,
    rgba(238, 226, 215, 0.45) 52%,
    rgba(245, 244, 242, 0) 72%
  );
}
.seed-empty-icon {
  position: relative;
  width: 40px;
  height: 40px;
  opacity: 0.85;
}
.seed-empty-title {
  color: #2c221e;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 1px;
}
.seed-empty-desc {
  max-width: 280px;
  margin: 8px auto 0;
  color: #8a7f77;
  font-size: 13px;
  line-height: 1.8;
}
.qx .seed-empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 22px;
  padding: 0 28px;
  border: 1px solid #d9c6b7;
  border-radius: 22px;
  color: #7a1c1c;
  font-size: 14px;
  background: transparent;
  transition: opacity 0.15s ease;
}
.seed-empty-action-pressed {
  opacity: 0.6;
}
