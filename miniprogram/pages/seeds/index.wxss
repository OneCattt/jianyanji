.qx .seed-card {
  width: 100%;
  padding: 0;
  margin: 28rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  text-align: left;
  background: #fffdfa;
  color: inherit;
  line-height: 1.7;
}
.seed-card::after {
  border: 0;
}
.seed-cover {
  display: block;
  width: 100%;
  height: 360rpx;
}
.seed-copy {
  padding: 28rpx;
  white-space: normal;
}
