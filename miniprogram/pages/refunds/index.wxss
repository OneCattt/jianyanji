.refund-line {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee6dd;
}
.refund-line label,
.refund-reason {
  display: block;
  margin-top: 16rpx;
}
.refund-line input {
  min-height: 88rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #d8cec4;
  border-radius: 12rpx;
}
.refund-reason textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #d8cec4;
  border-radius: 12rpx;
  box-sizing: border-box;
}
