page {
  background: #f5f4f2;
  color: #2c221e;
}
.privacy-page {
  padding: 20px 8px calc(24px + env(safe-area-inset-bottom));
  font-family: "PingFang SC", sans-serif;
}
.privacy-eyebrow {
  color: #796f68;
  font:
    18rpx/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  letter-spacing: 3rpx;
}
.privacy-title {
  margin-top: 8px;
  font:
    44rpx/1.5 -apple-system,
    "PingFang SC",
    sans-serif;
  font-size: 22px;
  font-weight: 600;
}
.privacy-version {
  margin-top: 14rpx;
  color: #796f68;
  font-size: 23rpx;
}
.privacy-summary {
  margin: 28rpx 0;
  font-size: 14px;
  line-height: 1.9;
}
.privacy-card {
  padding: 18px 16px;
  background: #ffffff;
  border-radius: 12px;
}
.privacy-label {
  margin-bottom: 12rpx;
  color: #796f68;
  font-size: 23rpx;
}
.privacy-value {
  display: block;
  margin-bottom: 24rpx;
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.privacy-section {
  padding-top: 36rpx;
  padding: 18px 16px;
  margin-top: 10px;
  border-radius: 12px;
  background: #fff;
}
.privacy-heading {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
}
.privacy-paragraph {
  display: block;
  margin-bottom: 22rpx;
  font-size: 27rpx;
  line-height: 1.95;
  white-space: pre-wrap;
}
.privacy-page button {
  width: 100%;
  height: auto;
  box-sizing: border-box;
  margin: 18rpx 0 0;
  border-radius: 24px;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: normal;
  min-height: 44px;
}
.privacy-page button::after {
  border: 0;
}
.privacy-page .privacy-link {
  min-height: 72rpx;
  padding-left: 0;
  text-align: left;
  color: #7a1c1c;
  background: transparent;
}
.privacy-page .privacy-primary {
  color: #ffffff;
  background: #7a1c1c;
}
.privacy-page .privacy-secondary {
  color: #7a1c1c;
  background: #f5e9e9;
}
.privacy-page button[disabled] {
  opacity: 0.5;
}
.privacy-page .privacy-primary.privacy-disabled {
  color: #6d625a;
  background: #e9e2d8;
  opacity: 1;
}
.privacy-rights {
  margin-top: 32rpx;
}
.privacy-consent {
  margin-top: 36rpx;
  border-top: 1rpx solid #eee9e4;
  padding-top: 28rpx;
}
.privacy-check {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
.privacy-check checkbox {
  flex-shrink: 0;
}
.privacy-note,
.privacy-error {
  margin-bottom: 24rpx;
  font-size: 25rpx;
  line-height: 1.8;
}
.privacy-error {
  padding: 24rpx;
  color: #7a1c1c;
  background: #f5e9e9;
  border-radius: 8px;
}
