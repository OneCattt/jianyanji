<tab-navigation title="清欣简妍肌" brand />
<view class="qx qx-tabpage qx-home">
  <view class="qx-hero">
    <image class="qx-hero-image" src="{{heroImage}}" mode="aspectFill" />
    <view class="qx-shade" />
    <view class="qx-hero-copy">
      <view class="qx-overline">东方肌肤管理美学</view>
      <view class="qx-hero-title">{{heroTitle}}</view>
      <view class="qx-hero-sub">{{heroSubtitle}}</view>
      <button class="qx-hero-button" bindtap="toMall" hover-class="home-entry-pressed">开启肌肤之旅 <text aria-hidden="true">→</text></button>
    </view>
  </view>

  <view class="qx-shortcuts">
    <button bindtap="toMall" hover-class="home-entry-pressed">
      <view class="home-entry-caption">COLLECTION</view>
      <view class="home-entry-title">臻选奢护</view>
      <text>探索全系高定单品</text>
    </button>
    <view class="home-entry-divider" aria-hidden="true" />
    <button bindtap="toInfo" hover-class="home-entry-pressed">
      <view class="home-entry-caption">BRAND PHILOSOPHY</view>
      <view class="home-entry-title">东方美学</view>
      <text>品牌哲思与授权标准</text>
    </button>
  </view>

  <view wx:if="{{featured}}" class="qx-section home-selected">
    <view class="qx-section-row">
      <view>
        <view class="qx-caption">SELECTED FOR YOU</view>
        <view class="qx-h2">今日臻选</view>
      </view>
      <button class="qx-text" bindtap="toMall" hover-class="home-entry-pressed">查看全部 <text aria-hidden="true">›</text></button>
    </view>
    <view class="qx-feature" bindtap="toProduct" aria-role="link" aria-label="查看{{featured.name}}">
      <image src="{{featured.imageCard}}" mode="aspectFill" lazy-load />
      <view class="qx-feature-copy">
        <text class="qx-badge">明星单品</text>
        <view class="qx-h2">{{featured.name}}</view>
        <text class="qx-muted">{{featured.subtitle}}</text>
        <view class="qx-price">{{featured.priceText}}</view>
        <button class="qx-primary" hover-class="home-entry-pressed">立即选购</button>
      </view>
    </view>
  </view>

  <view class="qx-section home-about">
    <view class="qx-caption">ABOUT QINGXIN</view>
    <view class="qx-h2">与品牌，共成长</view>
    <view class="qx-about">{{content ? content.introduction : '品牌资料尚未配置'}}</view>
    <button class="qx-info" bindtap="toInfo" hover-class="home-entry-pressed">品牌介绍与购买说明 <view class="qx-info-arrow" aria-hidden="true" /></button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <content-recommendations />
</view>
