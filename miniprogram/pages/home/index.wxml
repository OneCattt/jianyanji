<view class="qx qx-tabpage">
 <view class="qx-brand"><image class="qx-brand-logo" src="/assets/brand/logo-horizontal-red.png" mode="aspectFit" aria-label="清欣简妍肌" /></view>
 <view class="qx-hero"><image class="qx-hero-image" src="{{heroImage}}" mode="aspectFill"/><view class="qx-shade"/><view class="qx-hero-copy"><view class="qx-overline">东方肌肤管理美学</view><view class="qx-hero-title">{{heroTitle}}</view><view class="qx-hero-sub">{{heroSubtitle}}</view><button class="qx-hero-button" bindtap="toMall">开启肌肤之旅 <text>→</text></button></view></view>
 <view class="qx-shortcuts"><button bindtap="toMall"><image src="/assets/figma/shop-imgIcon.png"/><view>臻选商城</view><text>查看在售商品</text></button><button bindtap="toInfo"><image src="/assets/figma/Home-imgIcon1.png"/><view>品牌与购买说明</view><text>了解清欣简妍肌</text></button></view>
 <view wx:if="featured" class="qx-section"><view class="qx-section-row"><view><view class="qx-caption">SELECTED FOR YOU</view><view class="qx-h2">今日臻选</view></view><button class="qx-text" bindtap="toMall">查看全部 ›</button></view><view class="qx-feature" bindtap="toProduct"><image src="{{featured.image}}" mode="aspectFill"/><view class="qx-feature-copy"><text class="qx-badge">明星单品</text><view class="qx-h2">{{featured.name}}</view><text class="qx-muted">{{featured.subtitle}}</text><view class="qx-price">{{featured.priceText}}</view><button class="qx-primary">立即选购</button></view></view></view>
 <view class="qx-section"><view class="qx-caption">ABOUT QINGXIN</view><view class="qx-h2">与品牌，共成长</view><view class="qx-about">{{content ? content.introduction : '品牌资料尚未配置'}}</view><button class="qx-info" bindtap="toInfo">品牌介绍与购买说明 <text>↗</text></button></view><view wx:if="error" class="error">{{error}}</view>
 <content-recommendations />
</view>
