<view class="qx qx-tabpage"><view class="qx-shop-head"><view class="qx-caption">BRAND STORE</view><button class="qx-text" bindtap="cart">购物袋 ›</button><view class="qx-h1">臻选商城</view><view class="qx-muted">专业配方，为每一种肌肤状态而生</view></view><view class="qx-role"><text>{{identityName}}专享</text><view>普通商品按{{identityName}}价格，福利品统一价</view></view><scroll-view class="qx-categories" scroll-x><button class="{{categoryId===0?'chosen':''}}" data-id="0" bindtap="selectCategory">全部</button><button wx:for="{{categories}}" wx:key="id" class="{{categoryId===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</button></scroll-view><view class="qx-grid"><view class="qx-product" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image src="{{item.image}}" mode="aspectFill"/><view class="qx-product-copy"><view class="qx-muted">{{item.subtitle}}</view><view class="qx-product-name">{{item.name}}</view><view class="qx-section-row"><view class="qx-price">{{item.priceText}}</view><image class="qx-add" src="/assets/figma/shop-imgIcon2.png"/></view><text wx:if="!item.available" class="qx-muted">暂不可购买</text></view></view></view><view wx:if="!products.length" class="qx-empty">{{error || '商品尚未上架'}}</view><view wx:if="error" class="error">{{error}}</view></view>
