.ob-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f5f4f2;
}
.ob-background {
  position: absolute;
  inset: 0;
}
.ob-hero {
  width: 100%;
  height: 937.5rpx;
}
.ob-mask {
  position: fixed;
  inset: 0;
  background: #1f14118c;
  backdrop-filter: blur(8rpx);
}
.ob-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 86vh;
  background: #f5f4f2;
  border-radius: 16px 16px 0 0;
  box-shadow: 0 -31.915rpx 99.734rpx #190f0c33;
  overflow: hidden;
  padding-top: 57.846rpx;
}
.ob-handle {
  position: absolute;
  top: 17.952rpx;
  left: 45.2%;
  height: 7.979rpx;
  width: 71.809rpx;
  border-radius: 3.989rpx;
  background: #d6cec7;
}
.qx .ob-close {
  position: absolute;
  right: 8px;
  top: 12px;
  border-radius: 50%;
  background: #fff;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.ob-close image {
  width: 39.894rpx;
  height: 39.894rpx;
}
.ob-scroll {
  height: 100%;
}
.ob-inner {
  padding: 0 8px calc(96px + env(safe-area-inset-bottom));
}
.ob-overline {
  font:
    15.957rpx/23.936rpx -apple-system,
    "PingFang SC",
    sans-serif;
  letter-spacing: 2px;
  color: #796f68;
  height: 47.872rpx;
  padding-top: 19.947rpx;
  font-size: 10px;
  padding-left: 8px;
}
.ob-title {
  font:
    49.867rpx/74.8rpx -apple-system,
    "PingFang SC",
    sans-serif;
  letter-spacing: 0;
  padding-top: 9.973rpx;
  font-size: 22px;
  font-weight: 600;
  padding: 4px 8px 0;
}
.ob-sub {
  font-size: 12px;
  line-height: 29.92rpx;
  color: #796f68;
  margin-top: 13.963rpx;
  padding: 0 8px;
}
.ob-tabs {
  display: flex;
  margin-top: 16px;
  padding: 4px;
  background: #fff;
  border-radius: 24px;
}
.ob-tabs button {
  flex: 1;
  color: #796f68;
  padding: 10px;
  font-size: 14px;
  line-height: 32.912rpx;
  min-height: 44px;
  border-radius: 24px;
}
.ob-tabs button.active {
  background: #7a1c1c;
  color: #fff;
}
.ob-stats {
  display: flex;
  padding: 18px 8px;
  background: #ffffff;
  margin-top: 10px;
  border-radius: 12px;
}
.ob-stats > view {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 11.968rpx;
  padding: 0 3.989rpx;
  min-width: 0;
}
.ob-stats > view + view {
  border-left: 1.995rpx solid #eee9e4;
}
.ob-stats text {
  font-size: 11px;
  line-height: 23.936rpx;
  color: #796f68;
}
.ob-stats .ob-number {
  font:
    bold 25.931rpx/38.896rpx -apple-system,
    "PingFang SC",
    sans-serif;
  color: #7a1c1c;
  overflow-wrap: anywhere;
  font-size: 14px;
}
.ob-relationship {
  padding: 16px;
  background: #fff;
  border: 0;
  margin-top: 10px;
  border-radius: 12px;
}
.ob-section-label {
  font-size: 14px;
  font-weight: 600;
  line-height: 29.92rpx;
  color: #2c221e;
  margin: 11.968rpx 0;
}
.ob-columns {
  display: flex;
  gap: 19.947rpx;
  padding: 21.941rpx 0 17.952rpx;
}
.ob-columns > view {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  line-height: 29.92rpx;
}
.ob-columns text {
  display: block;
  font-size: 12px;
  line-height: 23.936rpx;
  color: #796f68;
  margin-bottom: 7.979rpx;
}
.ob-columns input {
  font-size: 13px;
  height: 44px;
  padding: 0;
  border: 0;
  background: transparent;
  border-radius: 0;
  margin: 0;
}
.ob-footnote {
  color: #9a8a80;
  font-size: 12px;
  line-height: 1.7;
  padding-top: 11.968rpx;
}
.ob-rights-image {
  display: block;
  width: 100%;
  margin-top: 29.92rpx;
}
.ob-rights,
.ob-address,
.ob-agreement-copy,
.ob-progress,
.ob-transfer {
  display: block;
  width: 100%;
  padding: 16px;
  border: 0;
  margin-top: 10px;
  text-align: left;
  background: #ffffff;
  border-radius: 12px;
}
.qx .ob-address {
  padding: 16px;
  background: #ffffff;
  border: 0;
  margin-top: 10px;
  text-align: left;
  border-radius: 12px;
}
.ob-body {
  font-size: 13px;
  line-height: 1.85;
  white-space: pre-line;
  color: #796f68;
  overflow-wrap: anywhere;
}
.ob-line {
  display: flex;
  justify-content: space-between;
  gap: 19.947rpx;
  font-size: 13px;
  padding: 19.947rpx 0;
  border-bottom: 1.995rpx solid #eee9e4;
  flex-wrap: wrap;
}
.ob-line text {
  font-size: 12px;
  color: #796f68;
}
.ob-agree {
  display: flex;
  align-items: flex-start;
  padding: 25.931rpx 3.989rpx 3.989rpx;
  gap: 15.957rpx;
}
.ob-agree checkbox {
  transform: scale(0.7);
  transform-origin: top left;
  width: 31.915rpx;
  height: 31.915rpx;
  flex-shrink: 0;
  margin-top: 7.979rpx;
}
.ob-agree text {
  font-size: 12px;
  line-height: 1.8;
  color: #796f68;
  flex: 1;
}
.ob-error {
  font-size: 21.941rpx;
  line-height: 1.8;
  color: #9d2032;
  padding: 23.936rpx 0;
}
.ob-fixed {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  gap: 12px;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  border-top: 1.995rpx solid #eee9e4;
  background: #fff;
  backdrop-filter: blur(19.947rpx);
  align-items: center;
}
.ob-fixed > view {
  flex: 1;
  min-width: 0;
}
.ob-fixed text {
  display: block;
  font-size: 12px;
  line-height: 23.936rpx;
  color: #796f68;
}
.ob-fixed .ob-number {
  display: block;
  font:
    bold 35.904rpx/53.856rpx -apple-system,
    "PingFang SC",
    sans-serif;
  color: #7a1c1c;
  font-size: 20px;
}
.qx .ob-apply {
  width: auto;
  min-height: 44px;
  padding: 10px 16px;
  background: #7a1c1c;
  color: #fff;
  font-size: 14px;
  line-height: 32.912rpx;
  min-width: 44%;
  border-radius: 24px;
}
.qx .ob-apply[disabled] {
  background: #ddd4cc;
  color: #7b6b5e;
  opacity: 1;
}
.ob-empty {
  padding: 99.734rpx 0;
  text-align: center;
  color: #796f68;
  font-size: 23.936rpx;
}
.ob-progress button {
  margin-top: 19.947rpx !important;
  color: #7a1c1c !important;
  font-size: 19.947rpx !important;
}
.qx .ob-transfer-toggle {
  font-size: 19.947rpx;
  color: #7a1c1c;
  padding: 27.926rpx 0;
  width: 100%;
  text-align: left;
}
.ob-transfer {
  margin-top: 0;
  font-size: 13px;
  line-height: 1.8;
}
.ob-account {
  font:
    25.931rpx -apple-system,
    "PingFang SC",
    sans-serif;
  overflow-wrap: anywhere;
  margin: 15.957rpx 0;
}
.ob-relationship button {
  min-height: 44px;
  padding: 10px 16px;
  border-radius: 24px;
  background: #f5e9e9;
  color: #7a1c1c;
  font-size: 13px;
}

.ob-line {
  display: block;
}
.ob-line-title {
  font-size: 14px;
  font-weight: 500;
}
.ob-line .ob-gift {
  display: inline-block;
  margin-left: 8px;
  padding: 2px 6px;
  border-radius: 4px;
  background: #f0e7dc;
  color: #7b5643;
  font-size: 11px;
}
.ob-ship-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}
.ob-ship-quantity input {
  width: 80px;
  min-height: 44px;
  padding: 0 8px;
  border: 0.5px solid #ded4cc;
  border-radius: 8px;
  background: #fff;
  text-align: center;
}
.qx .ob-combine {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  margin: 8px 0;
  color: #7a1c1c;
  text-align: left;
  font-size: 13px;
}
.ob-delivery-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.ob-delivery-option {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 4px;
  min-width: 108px;
  min-height: 48px;
  padding: 8px;
  border: 0.5px solid #e5dcd3;
  border-radius: 8px;
  font-size: 12px;
}
.ob-delivery-option radio {
  flex-shrink: 0;
  transform: scale(0.8);
}
.ob-delivery-selected {
  background: #f6eeea;
  border-color: #b59a88;
  color: #7a1c1c;
}
.qx .ob-pressed {
  opacity: 0.7;
}
