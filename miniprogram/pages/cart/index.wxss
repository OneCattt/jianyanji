.boutique-cart {
  min-height: 100vh;
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
  background: #f5f4f2;
  color: #2c221e;
  font-size: 13px;
}

.cart-content {
  padding: 8px;
}

.cart-panel {
  overflow: hidden;
  border-radius: 12px;
  background: #fff;
}

.cart-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 56px;
  padding: 0 16px;
  border-bottom: 0.5px solid #f0ece8;
}

.cart-brand-name {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #4a3a34;
  font-size: 14px;
  font-weight: 600;
}

.cart-brand-line {
  width: 1px;
  height: 12px;
  background: #7a1c1c;
}

.cart-login {
  padding: 64px 12px 24px;
  text-align: center;
}

.cart-login-icon {
  width: 48px;
  height: 48px;
  opacity: 0.65;
}

.cart-login-title {
  margin-top: 20px;
  font-size: 18px;
  font-weight: 500;
}

.cart-login-hint {
  margin-top: 10px;
  color: #9e948e;
  font-size: 12px;
  line-height: 1.8;
}

.boutique-cart .cart-login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200px;
  height: 44px;
  margin: 28px auto 0;
  border-radius: 24px;
  background: #7a1c1c;
  color: #fff;
  font-size: 14px;
}

.boutique-cart .cart-browse-button {
  margin: 8px auto 0;
  padding: 12px;
  color: #7a5c52;
  font-size: 12px;
}

.cart-login-error {
  margin-top: 16px;
  color: #7a5c52;
  font-size: 12px;
  line-height: 1.8;
}

.cart-swipe {
  position: relative;
  overflow: hidden;
  border-bottom: 0.5px solid #f0ece8;
}

.boutique-cart .cart-swipe-remove {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  background: #7a1c1c;
  color: #fff;
  font-size: 12px;
  visibility: hidden;
}

.boutique-cart .cart-swipe-remove-visible {
  visibility: visible;
}

.cart-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 16px 12px 20px;
  background: #fff;
  transform: translateX(0);
  transition: transform 180ms ease-out;
}

.cart-item-open {
  transform: translateX(-64px);
}

.boutique-cart .cart-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 96px;
  margin: 0 -6px;
}

.cart-check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  border: 0.5px solid #cbbfb5;
  border-radius: 50%;
  background: transparent;
}

.cart-check-selected {
  border-color: #7a1c1c;
  background: #7a1c1c;
}

.cart-check-tick {
  width: 8px;
  height: 5px;
  margin-top: -3px;
  border-bottom: 1.5px solid #fff;
  border-left: 1.5px solid #fff;
  transform: rotate(-45deg);
}

.cart-image {
  flex-shrink: 0;
  width: 96px;
  height: 96px;
  border-radius: 10px;
  background: #f5efea;
}

.cart-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 96px;
}

.cart-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 6px;
}

.cart-name {
  flex: 1;
  min-width: 0;
  color: #2c221e;
  font-size: 14px;
  font-weight: 500;
  line-height: 21px;
  word-break: break-all;
}

.boutique-cart .cart-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  margin: -4px -6px -3px 0;
  background: transparent;
  color: #a69c94;
  font-size: 22px;
  font-weight: 300;
  line-height: 1;
}

.boutique-cart .cart-remove-pressed {
  color: #7a1c1c;
}

.cart-spec-row {
  margin-top: 5px;
  margin-bottom: 10px;
}

.cart-spec {
  display: inline-block;
  max-width: 100%;
  color: #796f68;
  font-size: 12px;
  line-height: 16px;
  word-break: break-all;
}

.cart-purchase {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-top: auto;
}

.cart-price {
  color: #2c221e;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 32px;
  white-space: nowrap;
}

.cart-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 34px;
  margin-left: auto;
  border: 0.5px solid #e7e1dc;
  border-radius: 6px;
  overflow: hidden;
}

.boutique-cart .cart-step {
  width: 32px;
  height: 33px;
  color: #4a3a34;
  font-size: 14px;
  line-height: 33px;
}

.boutique-cart .cart-quantity {
  box-sizing: border-box;
  width: 36px;
  min-height: 0;
  height: 33px;
  padding: 0;
  border: 0;
  border-right: 0.5px solid #f0ece8;
  border-left: 0.5px solid #f0ece8;
  border-radius: 0;
  background: transparent;
  color: #2c221e;
  font-size: 12px;
  line-height: 33px;
  text-align: center;
}

.cart-unavailable {
  margin-top: 8px;
  color: #9e948e;
  font-size: 11px;
  line-height: 1.6;
}

.cart-list-footer {
  padding: 12px 0;
  color: #b8b0a8;
  font-size: 12px;
  text-align: center;
}

.boutique-cart .cart-retry {
  color: #7a1c1c;
  font-size: 12px;
}

.cart-empty {
  padding: 64px 0;
  color: #9e948e;
  text-align: center;
}

.cart-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
}

.boutique-cart .cart-pricing-info {
  min-height: 44px;
  margin: 0 auto;
  color: #796f68;
  font-size: 12px;
  line-height: 44px;
}

.cart-action-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 72px;
  padding: 8px 12px;
  background: #fff;
}

.boutique-cart .cart-select-all {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 6px;
  height: 44px;
  color: #6e5a4f;
  font-size: 12px;
}

.cart-total {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4px;
  min-width: 0;
}

.cart-total-label {
  color: #4a3a34;
  font-size: 13px;
}

.cart-total-value {
  color: #7a1c1c;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 21px;
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
}

.boutique-cart .cart-checkout {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 128px;
  height: 44px;
  border-radius: 24px;
  background: #7a1c1c;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 2px;
}

.boutique-cart .cart-checkout-pressed {
  background: #631717;
}

.boutique-cart .cart-control-disabled {
  opacity: 0.35;
}

.boutique-cart .cart-manage {
  min-width: 44px;
  min-height: 44px;
  color: #796f68;
  font-size: 13px;
  line-height: 44px;
}

@media (max-width: 360px) {
  .cart-brand-name {
    gap: 6px;
    font-size: 12px;
  }
  .cart-item {
    gap: 8px;
    padding-right: 10px;
    padding-left: 10px;
  }
  .cart-action-bar {
    gap: 8px;
    padding: 0 12px;
  }
  .cart-total-value {
    font-size: 18px;
  }
  .cart-image {
    width: 80px;
    height: 80px;
  }
  .cart-total {
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }
  .boutique-cart .cart-checkout {
    width: 112px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cart-item {
    transition: none;
  }
}
