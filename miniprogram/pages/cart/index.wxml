<view class="qx qx-flow"><view class="qx-flow-content"><view class="qx-notice">清欣简妍肌品牌仓<view class="qx-muted">以下商品由品牌仓统一发货</view></view><view class="qx-sheet"><view wx:for="{{items}}" wx:key="skuId" class="qx-cart-line"><checkbox checked="{{item.selected}}" color="#8d1724" data-id="{{item.skuId}}" data-action="toggle" bindtap="change"/><image src="{{item.image}}" mode="aspectFill"/><view class="qx-line-copy"><view>{{item.name}}</view><text class="qx-badge">{{item.skuName}}{{item.productType === 'welfare' ? ' · 福利品' : ''}}</text><view class="qx-price">{{item.priceText}}</view><view class="qx-quantity"><button data-id="{{item.skuId}}" data-delta="-1" bindtap="change" disabled="{{busy || item.quantity<=1}}">−</button><text>{{item.quantity}}</text><button data-id="{{item.skuId}}" data-delta="1" bindtap="change" disabled="{{busy || item.quantity>=item.stock}}">+</button></view><button class="qx-text" data-id="{{item.skuId}}" data-action="remove" bindtap="change">移除</button><view wx:if="{{!item.available}}" class="qx-muted">商品暂不可购买，请检查库存或联系品牌方</view></view></view><view wx:if="{{!items.length}}" class="qx-empty">购物袋暂无商品</view></view><view class="qx-notice">已选 {{kinds}} 种商品，共 {{pieces}} 件。结算时按当前身份核价。</view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="qx-fixed"><view><view class="qx-muted">合计</view><view class="qx-price">{{totalText}}</view></view><button class="qx-primary" bindtap="checkout" disabled="{{!kinds || busy}}">去结算</button></view></view>
