<view class="qx boutique-cart">
  <view class="cart-content">
    <view class="cart-brand">
      <view class="cart-brand-name"
        ><view class="cart-brand-line" aria-hidden="true" /><text
          >清欣简妍肌 · 品牌直发仓</text
        ></view
      >
      <text class="cart-brand-shipping">统一顺丰/专配发货</text>
    </view>

    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="skuId" class="cart-swipe">
        <button
          class="cart-swipe-remove {{swipeSkuId === item.skuId ? 'cart-swipe-remove-visible' : ''}}"
          data-id="{{item.skuId}}"
          data-action="remove"
          catchtap="change"
          disabled="{{busy || itemsLoading || swipeSkuId !== item.skuId}}"
          aria-hidden="{{swipeSkuId !== item.skuId}}"
          aria-label="移除{{item.name}}"
        >
          移除
        </button>
        <view
          class="cart-item {{swipeSkuId === item.skuId ? 'cart-item-open' : ''}}"
          data-id="{{item.skuId}}"
          bindtouchstart="touchStart"
          bindtouchmove="touchMove"
          bindtouchend="touchEnd"
          bindtouchcancel="touchCancel"
          bindtap="closeSwipe"
        >
          <button
            class="cart-check"
            data-id="{{item.skuId}}"
            data-action="toggle"
            catchtap="change"
            disabled="{{busy || itemsLoading}}"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            aria-label="选择{{item.name}}"
          >
            <view
              class="cart-check-box {{item.selected ? 'cart-check-selected' : ''}}"
              ><view wx:if="{{item.selected}}" class="cart-check-tick"
            /></view>
          </button>
          <image
            class="cart-image"
            src="{{item.imageThumb}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="cart-copy">
            <view class="cart-heading">
              <text class="cart-name">{{item.name}}</text>
              <button
                class="cart-remove"
                data-id="{{item.skuId}}"
                data-action="remove"
                catchtap="change"
                disabled="{{busy || itemsLoading}}"
                hover-class="cart-remove-pressed"
                aria-label="移除{{item.name}}"
              >
                ×
              </button>
            </view>
            <view class="cart-spec-row"
              ><text class="cart-spec"
                >{{item.skuName}}{{item.productType === 'welfare' ? ' · 福利品'
                : ''}}</text
              ></view
            >
            <view class="cart-purchase">
              <text class="cart-price">{{item.priceText}}</text>
              <view class="cart-stepper">
                <button
                  class="cart-step {{busy || itemsLoading || item.quantity <= 1 || item.stock < 1 ? 'cart-control-disabled' : ''}}"
                  data-id="{{item.skuId}}"
                  data-delta="-1"
                  catchtap="change"
                  disabled="{{busy || itemsLoading || item.quantity <= 1 || item.stock < 1}}"
                  aria-label="减少{{item.name}}数量"
                >
                  −
                </button>
                <input
                  class="cart-quantity"
                  type="number"
                  value="{{item.quantity}}"
                  maxlength="3"
                  confirm-type="done"
                  cursor-spacing="120"
                  data-id="{{item.skuId}}"
                  bindfocus="startQuantityEdit"
                  bindinput="editQuantity"
                  bindblur="commitQuantity"
                  bindconfirm="confirmQuantity"
                  disabled="{{busy || itemsLoading || item.stock < 1}}"
                  aria-label="{{item.name}}购买数量，最多999件"
                />
                <button
                  class="cart-step {{busy || itemsLoading || item.quantity >= item.stock || item.quantity >= 999 ? 'cart-control-disabled' : ''}}"
                  data-id="{{item.skuId}}"
                  data-delta="1"
                  catchtap="change"
                  disabled="{{busy || itemsLoading || item.quantity >= item.stock || item.quantity >= 999}}"
                  aria-label="增加{{item.name}}数量"
                >
                  +
                </button>
              </view>
            </view>
            <view wx:if="{{!item.available}}" class="cart-unavailable"
              >商品暂不可购买，请检查库存或联系品牌方</view
            >
          </view>
        </view>
      </view>
      <view
        wx:if="{{!items.length && !itemsLoading && !error}}"
        class="qx-empty cart-empty"
        >购物袋暂无商品</view
      >
    </view>

    <view class="cart-list-footer" aria-live="polite">
      <text wx:if="{{itemsLoading}}">正在加载…</text>
      <button
        wx:elif="{{error && itemsHasMore}}"
        class="cart-retry"
        bindtap="onReachBottom"
      >
        加载失败，点击重试
      </button>
      <text wx:elif="{{itemsLoaded && !itemsHasMore && items.length && !error}}"
        >— 已全部加载 —</text
      >
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view class="cart-dock">
    <view class="cart-summary">
      <text class="cart-selection-count"
        >已选 {{kinds}} 种 · 共 {{pieces}} 件</text
      >
      <button
        class="cart-pricing-info"
        bindtap="showPricingInfo"
        aria-label="结算时按代理商等级自动核价，查看核价说明"
      >
        结算时按代理商等级自动核价 <text aria-hidden="true">ⓘ</text>
      </button>
    </view>
    <view class="cart-action-bar">
      <button
        class="cart-select-all"
        bindtap="toggleAll"
        disabled="{{busy || itemsLoading || !totalKinds}}"
        aria-role="checkbox"
        aria-checked="{{allSelected}}"
        aria-label="全选购物袋全部商品"
      >
        <view
          class="cart-check-box {{allSelected ? 'cart-check-selected' : ''}}"
          ><view wx:if="{{allSelected}}" class="cart-check-tick"
        /></view>
        <text>全选</text>
      </button>
      <view class="cart-total"
        ><text class="cart-total-label">合计</text
        ><text class="cart-total-value">{{totalText}}</text></view
      >
      <button
        class="cart-checkout {{!kinds || busy || itemsLoading ? 'cart-control-disabled' : ''}}"
        bindtap="checkout"
        disabled="{{!kinds || busy || itemsLoading}}"
        hover-class="cart-checkout-pressed"
      >
        去结算
      </button>
    </view>
  </view>
</view>
