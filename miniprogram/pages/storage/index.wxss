/* 与个人中心沿用暖白卡片、棕色线性图标与酒红操作色。 */
page {
  background: #f5f4f2;
}
.qx.storage-page {
  padding: 32rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  background: #f5f4f2;
  color: #302824;
}
.storage-head {
  padding: 12rpx 4rpx 32rpx;
}
.storage-eyebrow {
  margin-bottom: 12rpx;
  color: #866b59;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}
.storage-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
}
.storage-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #746a63;
  line-height: 1.8;
}
.storage-muted,
.storage-source {
  color: #746a63;
  font-size: 24rpx;
  line-height: 1.8;
}
.storage-source {
  margin-top: 8rpx;
  font-size: 22rpx;
  overflow-wrap: anywhere;
}
.storage-tabs {
  display: flex;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #e2d9d1;
}
.qx.storage-page .storage-tabs button {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  color: #746a63;
  font-size: 26rpx;
}
.qx.storage-page .storage-tabs .active {
  color: #7a1c1c;
  font-weight: 600;
}
.qx.storage-page .storage-tabs .active::after {
  content: "";
  position: absolute;
  left: 32%;
  right: 32%;
  bottom: -1rpx;
  height: 4rpx;
  border: 0;
  border-radius: 4rpx;
  background: #7a1c1c;
}
.qx.storage-page .storage-card {
  display: block;
  width: 100%;
  background: #fffdfa;
  border: 1rpx solid #eae2da;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  text-align: left;
  font-size: 28rpx;
  line-height: 1.6;
}
.storage-card-title {
  font-weight: 600;
  font-size: 30rpx;
  line-height: 1.6;
}
.storage-gift {
  display: inline-block;
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #f0e7dc;
  color: #7b5643;
  font-size: 21rpx;
  font-weight: 400;
  vertical-align: middle;
}
.storage-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  border-top: 1rpx solid #eee6e0;
  margin-top: 24rpx;
  padding-top: 20rpx;
  font-size: 26rpx;
}
.storage-quantity input {
  width: 144rpx;
  min-height: 44px;
  text-align: center;
  border: 1rpx solid #ded4cc;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fff;
}
.storage-error,
.storage-expired {
  color: #962c32;
  font-size: 26rpx;
  line-height: 1.8;
  padding: 20rpx 0;
}
.storage-error {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f8ece9;
}
.qx.storage-page .storage-error button {
  min-height: 44px;
  margin-top: 12rpx;
  color: #7a1c1c;
  text-align: left;
  font-size: 26rpx;
  text-decoration: underline;
}
.storage-empty {
  padding: 56rpx 28rpx 44rpx;
  border: 1rpx solid #eae2da;
  border-radius: 20rpx;
  background: #fffdfa;
  text-align: center;
}
.storage-empty-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0e7dc;
}
.storage-empty-icon image {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.85;
}
.storage-empty-title {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.6;
}
.storage-empty-copy {
  margin-top: 14rpx;
  color: #746a63;
  font-size: 25rpx;
  line-height: 1.9;
}
.qx.storage-page .storage-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 44px;
  padding: 16rpx 36rpx;
  border: 1rpx solid #bda996;
  border-radius: 48rpx;
  color: #704c3d;
  font-size: 26rpx;
}
.storage-empty .storage-outline {
  margin-top: 32rpx;
}
.storage-guide {
  margin-top: 28rpx;
  padding: 0 12rpx 16rpx;
}
.qx.storage-page .storage-guide-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  text-align: left;
}
.storage-guide-title {
  font-size: 26rpx;
  font-weight: 500;
}
.storage-guide-action {
  font-size: 23rpx;
  color: #796b62;
}
.storage-guide-copy {
  font-size: 23rpx;
  color: #746a63;
  line-height: 1.8;
}
.storage-freight {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e2d9d1;
  color: #746a63;
  font-size: 24rpx;
  line-height: 1.8;
}
.storage-freight > view + view {
  margin-top: 20rpx;
}
.storage-freight text {
  color: #514139;
  font-weight: 500;
}
.storage-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: #fffdfa;
  border-top: 1rpx solid #e5dcd3;
  z-index: 10;
}
.storage-selection {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
}
.storage-selection text {
  margin: 0 4rpx;
  font-family: Georgia, serif;
  color: #7a1c1c;
  font-size: 40rpx;
}
.storage-selection .storage-muted {
  font-size: 21rpx;
}
.qx.storage-page .storage-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 44px;
  width: 52%;
  padding: 20rpx 16rpx;
  border-radius: 48rpx;
  background: #7a1c1c;
  color: #fff;
  font-size: 27rpx;
  font-weight: 500;
}
.qx.storage-page .storage-submit[disabled] {
  background: #e8ded5;
  color: #7b6b5e;
  opacity: 1;
}
.storage-record-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 28rpx;
}
.storage-status {
  color: #7a1c1c;
  font-size: 24rpx;
}
.storage-record-link {
  margin-top: 20rpx;
  color: #7b5643;
  font-size: 24rpx;
}
.storage-subscription {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 12rpx 0 28rpx;
}
.storage-subscription .storage-outline {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
}
.storage-help {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #746a63;
  line-height: 1.8;
}
.storage-card label,
.storage-page radio-group label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 44px;
}
.storage-card label input {
  min-height: 44px;
  max-width: 160rpx;
  border: 1rpx solid #ded4cc;
  border-radius: 8rpx;
  text-align: center;
}
.qx.storage-page .storage-pressed {
  opacity: 0.7;
}

/* 商品展示沿用商城的图文结构，寄存数量与提货操作保持清晰。 */
.qx.storage-shop {
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}
.storage-shop .storage-head {
  padding: 8rpx 8rpx 20rpx;
}
.storage-shop .storage-eyebrow {
  margin-bottom: 6rpx;
  font-size: 20rpx;
}
.storage-shop .storage-title {
  font-size: 40rpx;
}
.storage-shop .storage-subtitle {
  margin-top: 4rpx;
  font-size: 23rpx;
}
.storage-shop .storage-tabs {
  margin-bottom: 16rpx;
}
.qx.storage-shop .storage-card {
  padding: 28rpx;
  margin: 20rpx 0;
  border: 0;
  border-radius: 24rpx;
  background: #fff;
}
.storage-product-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  min-width: 0;
}
.storage-product-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #f5f4f2;
  border-radius: 16rpx;
}
.storage-product-cover image {
  width: 100%;
  height: 100%;
}
.storage-product-cover .storage-product-placeholder {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.45;
}
.storage-product-copy {
  flex: 1;
  min-width: 0;
}
.storage-product-name {
  color: #2c221e;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.storage-product-sku,
.storage-product-origin {
  margin-top: 6rpx;
  color: #746a63;
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.storage-product-origin {
  font-size: 21rpx;
}
.storage-product-count {
  flex-shrink: 0;
  color: #746a63;
  font-size: 25rpx;
  padding-top: 4rpx;
}
.storage-available {
  margin-top: 12rpx;
  color: #7a1c1c;
  font-size: 23rpx;
}
.storage-available text {
  margin: 0 6rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.storage-available-muted {
  color: #746a63;
}
.storage-lot-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: #f8f7f5;
  border-radius: 10rpx;
  color: #746a63;
  font-size: 22rpx;
}
.storage-hold-note {
  margin-top: 14rpx;
  color: #746a63;
  font-size: 22rpx;
  line-height: 1.6;
}
.storage-lot-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0 16rpx;
  color: #746a63;
  font-size: 22rpx;
}
.qx .storage-lot-meta button {
  min-height: 44px;
  color: #746a63;
  font-size: 22rpx;
}
.storage-shop .storage-quantity {
  min-height: 44px;
  margin-top: 0;
  padding-top: 16rpx;
  font-size: 25rpx;
}
.storage-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  overflow: hidden;
  border: 1rpx solid #eee9e4;
  border-radius: 12rpx;
  background: #f5f4f2;
}
.qx .storage-stepper button {
  width: 44px;
  min-height: 44px;
  padding: 0;
  color: #2c221e;
  font-size: 18px;
}
.qx .storage-stepper button[disabled] {
  color: #a39b95;
  background: transparent;
  opacity: 0.5;
}
.storage-stepper input {
  width: 40px;
  min-height: 44px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #fff;
  font-size: 14px;
}
.storage-record-head {
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #eee9e4;
  font-weight: 500;
}
.storage-status {
  flex-shrink: 0;
  font-weight: 400;
}
.storage-status-muted {
  color: #746a63;
}
.storage-record-product + .storage-record-product {
  margin-top: 24rpx;
}
.storage-record-product .storage-product-cover {
  width: 128rpx;
  height: 128rpx;
}
.storage-record-product .storage-product-name {
  font-size: 26rpx;
}
.storage-record-more,
.storage-record-number,
.storage-record-reason {
  margin-top: 20rpx;
  color: #746a63;
  font-size: 22rpx;
  line-height: 1.6;
}
.storage-record-number {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.storage-record-reason {
  color: #7a1c1c;
}
.storage-record-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee9e4;
  color: #746a63;
  font-size: 22rpx;
}
.storage-record-footer .storage-record-link {
  margin-top: 0;
  color: #7a1c1c;
  font-size: 23rpx;
}

/* 活动套餐与提货详情共用的操作样式。 */
.qx.storage-page .storage-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  padding: 22rpx 28rpx;
  border-radius: 48rpx;
  background: #7a1c1c;
  color: #fff;
  font-size: 28rpx;
}
.qx.storage-page .storage-primary[disabled],
.qx.storage-page .storage-outline[disabled] {
  background: #e8ded5;
  border-color: #e8ded5;
  color: #7b6b5e;
  opacity: 1;
}
.qx.storage-page .storage-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 44px;
  padding: 24rpx 0;
  text-align: left;
  font-size: 27rpx;
}
.storage-link-row + .storage-link-row {
  border-top: 1rpx solid #eee6df;
}
.storage-link-arrow {
  color: #8b7566;
  flex-shrink: 0;
  font-size: 36rpx;
}
.storage-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.storage-page .storage-options .storage-option {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 220rpx;
  min-height: 48px;
  padding: 16rpx;
  border: 1rpx solid #e5dcd3;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.storage-option radio {
  flex-shrink: 0;
  transform: scale(0.8);
}
.storage-page .storage-options .storage-option-selected {
  background: #f6eeea;
  border-color: #b59a88;
  color: #7a1c1c;
}
