<import src="../../templates/list-footer.wxml" />
<view class="qx jy-orders">
  <view class="jy-search">
    <input
      value="{{keywordInput}}"
      placeholder="搜索商品或订单号"
      maxlength="200"
      confirm-type="search"
      bindinput="keywordInput"
      bindconfirm="search"
      aria-label="搜索商品或订单号"
    />
    <button wx:if="{{keyword||keywordInput}}" bindtap="clearSearch">清空</button>
    <button wx:else bindtap="search">搜索</button>
  </view>
  <view class="jy-tabs"
    ><button
      wx:for="{{tabs}}"
      wx:key="*this"
      data-index="{{index}}"
      class="{{tab===index?'selected':''}}"
      bindtap="select"
    >
      {{item}}
    </button></view
  >
  <view class="jy-list">
    <view wx:if="{{error}}" class="jy-error" role="alert"
      >{{error}}<button bindtap="load">重试</button></view
    >
    <view wx:if="{{ordersLoading && !orders.length}}" class="jy-empty"
      >正在查询订单…</view
    >
    <view
      wx:elif="{{!orders.length && !error && !ordersLoading}}"
      class="jy-empty"
      >{{keyword ? '没有找到相关订单，试试清空搜索条件' :
      '暂无' + (tab ? tabs[tab] : '') + '订单'}}<button
        wx:if="{{keyword}}"
        bindtap="clearSearch"
        >清空搜索</button
      ></view
    >
    <view wx:for="{{orders}}" wx:key="id" class="jy-card">
      <view class="jy-order-top"
        ><text>订单 {{item.number}}</text
        ><text class="jy-status">{{item.stateText}}</text></view
      >
      <view
        wx:for="{{item.displayLines}}"
        wx:for-item="line"
        wx:key="lineKey"
        class="jy-product"
        ><image src="{{line.imageThumb}}" mode="aspectFill" lazy-load /><view
          class="jy-product-copy"
          ><view>{{line.name}}</view
          ><text>{{line.skuName}} · 品牌仓发货</text></view
        ><view class="jy-line-price"
          >{{line.priceText}}<view>×{{line.quantity}}</view></view
        ></view
      >
      <view class="jy-order-hint"
        ><image src="/pages/order/assets/list-imgIcon1.png" /><text
          >{{item.hint}}</text
        ></view
      >
      <view class="jy-order-bottom"
        ><view
          ><view wx:if="{{item.scopeText}}" class="jy-scope-count">{{item.scopeText}} {{item.count}} 件 · 原订单共 {{item.originalCount}} 件</view>
          <text wx:else>共 {{item.count}} 件 </text><text>{{item.scopeText?'原订单':''}}{{item.paid?'实付':'应付'}} </text>
          <text class="jy-total">{{item.amountText}}</text></view
        ><view class="jy-order-actions"
          ><button
            wx:if="{{item.actionKind !== 'detail'}}"
            class="jy-action-link"
            bindtap="detail"
            data-id="{{item.id}}"
            >查看详情</button
          ><button
            class="jy-action-primary"
            bindtap="primary"
            data-id="{{item.id}}"
            data-action="{{item.actionKind}}"
            >{{item.actionText}}</button
          ></view
        ></view
      >
    </view>
  </view>
  <template
    wx:if="{{ordersLoading||orders.length||error}}"
    is="list-footer"
    data="{{loading:ordersLoading,loaded:ordersLoaded,hasMore:ordersHasMore,error:error}}"
/></view>
