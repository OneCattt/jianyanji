@import "../order/common.wxss";
.jy-scope-count {
  margin-bottom: 8rpx;
  color: #5f544e;
  font-size: 24rpx;
  line-height: 1.6;
}
.jy-tabs {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-bottom: 0;
  padding: 4px;
  margin: 8px;
  border-radius: 12px;
}
.jy-tabs button {
  flex: 1;
  font-size: 12px;
  color: #796f68;
  position: relative;
  padding: 10px 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.jy-tabs button.selected {
  color: #7a1c1c;
  font-weight: 600;
  background: #f5e9e9;
  border-radius: 24px;
}
.jy-tabs button.selected:after {
  content: "";
  display: none;
  position: absolute;
  bottom: 0;
  left: 28%;
  right: 28%;
  height: 3.989rpx;
  background: #7a1c1c;
}

.jy-search {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 8px 8px 0;
  padding: 6px 12px;
  border-radius: 12px;
  background: #ffffff;
}
.jy-search input {
  flex: 1;
  min-width: 0;
  height: 40px;
  min-height: 40px;
  padding: 0 12px;
  border: 0;
  border-radius: 8px;
  background: #f5f4f2;
  font-size: 13px;
  line-height: 40px;
  color: #251d1a;
}
.jy-search button {
  flex-shrink: 0;
  height: 40px;
  min-height: 40px;
  padding: 0 6px;
  color: #7a1c1c;
  font-size: 13px;
  line-height: 40px;
}
.jy-order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex: 1;
  min-width: 0;
}
.jy-order-bottom .jy-order-actions button {
  border: 0;
  border-radius: 20px;
  box-shadow: none;
  line-height: 40px;
  min-height: 40px;
}
.jy-order-bottom .jy-order-actions button::after {
  border: 0;
}
.jy-order-actions .jy-action-link {
  padding: 0 10px;
  color: #796f68;
  font-size: 12px;
  background: transparent;
}
.jy-order-bottom .jy-order-actions .jy-action-primary {
  padding: 0 18px;
  border: 1.995rpx solid #7a1c1c;
  background: transparent;
  color: #7a1c1c;
  font-size: 13px;
}
.jy-empty button {
  display: block;
  margin: 12px auto 0;
  min-height: 40px;
  color: #7a1c1c;
}
