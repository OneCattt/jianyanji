@import "../order/common.wxss";
.jy-scope-count {
  margin-bottom: 8rpx;
  color: #5f544e;
  font-size: 24rpx;
  line-height: 1.6;
}
.jy-tabs {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-bottom: 0;
  padding: 4px;
  margin: 8px;
  border-radius: 12px;
}
.jy-tabs button {
  flex: 1;
  font-size: 12px;
  color: #796f68;
  position: relative;
  padding: 10px 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.jy-tabs button.selected {
  color: #7a1c1c;
  font-weight: 600;
  background: #f5e9e9;
  border-radius: 24px;
}
.jy-tabs button.selected:after {
  content: "";
  display: none;
  position: absolute;
  bottom: 0;
  left: 28%;
  right: 28%;
  height: 3.989rpx;
  background: #7a1c1c;
}
