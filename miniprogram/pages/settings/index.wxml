<view class="settings-page">
  <view class="settings-eyebrow">MY QINGXIN</view><view class="settings-title">个人设置</view>
  <view class="settings-card">
    <view class="settings-identity"><view class="settings-avatar">妍</view><view><view class="settings-name">{{user ? user.nickname : '欢迎，新朋友'}}</view><view class="settings-role">{{user ? user.identityName : '尚未登录'}}</view></view></view>
    <view class="settings-help">{{!user ? '使用微信登录后，查看订单并保存你的联系方式。' : user.identity === 'D' ? '当前为游客身份，可下单后线下付款，财务核款后发货。登录不会自动开通代理身份。' : '你的代理身份已生效，下单使用对应身份价格，可线下付款或使用已有积分订货。'}}</view>
    <button wx:if="{{!user}}" class="settings-primary" bindtap="onLogin" loading="{{busy}}" disabled="{{busy}}">微信登录</button>
  </view>
  <view wx:if="{{user}}" class="settings-card">
    <view class="settings-section-title">个人资料</view>
    <view class="settings-label">昵称</view><input value="{{nickname}}" bindinput="onNickname" maxlength="30" placeholder="填写昵称" disabled="{{busy}}" />
    <view class="settings-label">联系电话</view><input value="{{phone}}" bindinput="onPhone" type="number" maxlength="11" placeholder="选填，11 位手机号" disabled="{{busy}}" />
    <view class="settings-help">联系电话用于品牌方与你沟通，不代表已完成手机号认证。</view>
    <button class="settings-primary" bindtap="onSave" loading="{{busy}}" disabled="{{busy}}">保存资料</button>
    <button class="settings-logout" bindtap="onLogout" disabled="{{busy}}">退出登录</button>
  </view>
  <view wx:if="{{error}}" class="settings-error">{{error}}</view>
  <view wx:if="{{devAuth}}" class="settings-dev"><view class="settings-section-title">本地调试账号</view><picker range="{{accounts}}" value="{{accountIndex}}" bindchange="onAccount" disabled="{{busy}}"><button class="settings-secondary" disabled="{{busy}}">{{accounts[accountIndex]}} · 点击选择</button></picker><button class="settings-primary" bindtap="onLogin" loading="{{busy}}" disabled="{{busy}}">{{user ? '切换到所选账号' : '使用所选账号登录'}}</button></view>
</view>
