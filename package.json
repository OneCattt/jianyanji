{
  "name": "jianyanji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/java.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "seed:demo": "node scripts/java.mjs seed",
    "bootstrap:admin": "node scripts/java.mjs bootstrap",
    "test": "node scripts/java.mjs test",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "vite build",
    "format:check": "prettier --check server web miniprogram scripts vite.config.ts tsconfig.json tsconfig.web.json package.json",
    "start": "node scripts/java.mjs start",
    "check:miniprogram": "node scripts/check-miniprogram.cjs",
    "test:api:mysql": "node scripts/java.mjs integration",
    "test:legacy": "tsx --test server/*.test.ts",
    "build:api": "node scripts/java.mjs build",
    "export:legacy": "node scripts/export-sqlite.mjs",
    "import:legacy": "node scripts/java.mjs import",
    "dev:db": "node scripts/local-mysql.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vue-tsc": "^3.1.1"
  }
}
